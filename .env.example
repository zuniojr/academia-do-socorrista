# ==========================================
# Academia do Socorrista - Configurações do Painel Admin
# ==========================================

# Senha de acesso ao painel administrativo (usada em produção e localmente)
ADMIN_PASSWORD=sua-senha-super-segura-aqui

# Segredo para assinatura de cookies e tokens de sessão (gerar string aleatória de 32+ caracteres)
SESSION_SECRET=segredo-longo-e-aleatorio-para-assinatura-de-sessao-32chars

# Configurações do Repositório GitHub (usado nas Vercel Functions para rascunhos e PRs)
GITHUB_TOKEN=ghp_seuTokenPessoalComEscopoRepoOuGitHubAppToken
GITHUB_OWNER=zuniojr
GITHUB_REPO=academia-do-socorrista
GITHUB_BASE_BRANCH=main
GITHUB_DRAFT_BRANCH=cms-drafts
