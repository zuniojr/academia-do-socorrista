---
<section class="hero-v2">
	<div class="hero-v2__container">
		<div class="hero-v2__content">
			<h1 class="hero-v2__title">
				Aprenda Atendimento<br/>
				<span class="text-red">Pré-Hospitalar</span> com<br/>
				quem vive o resgate<br/>
				todos os dias.
			</h1>
			<p class="hero-v2__subtitle">
				Curso online desenvolvido por profissionais experientes<br/>
				para formar socorristas preparados para agir nas<br/>
				situações mais críticas.
			</p>
			<div class="hero-v2__actions">
				<a href="#" class="btn-primary-v2">Conheça os Cursos</a>
				<a href="#" class="btn-secondary-v2">
					Começar Agora 
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
		</div>
		<div class="hero-v2__image">
			<div class="hero-v2__overlay"></div>
		</div>
	</div>
</section>

<style>
	.hero-v2 {
		width: 100%;
		padding: 0 20px;
		display: flex;
		justify-content: center;
		margin-top: 100px; /* Space for fixed header if any */
	}

	.hero-v2__container {
		width: 100%;
		max-width: 1240px;
		aspect-ratio: 3.1 / 1;
		min-height: 400px;
		background-color: #07111D;
		border-radius: 12px;
		display: flex;
		overflow: hidden;
		position: relative;
	}

	.hero-v2__content {
		width: 42%;
		padding-left: 18px;
		padding-top: 15px;
		padding-right: 20px;
		padding-bottom: 15px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		z-index: 2;
	}

	.hero-v2__title {
		font-family: 'Inter', sans-serif;
		font-weight: 800;
		color: #FFFFFF;
		font-size: clamp(32px, 3.5vw, 60px);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0;
		margin-bottom: 10px;
	}

	.text-red {
		color: #E53935;
	}

	.hero-v2__subtitle {
		font-family: 'Inter', sans-serif;
		font-weight: 400;
		color: #C8CDD7;
		font-size: clamp(14px, 1.2vw, 20px);
		line-height: 1.5;
		margin: 0;
		margin-bottom: 14px;
	}

	.hero-v2__actions {
		display: flex;
		gap: 8px;
	}

	.btn-primary-v2 {
		background-color: #D62828;
		color: #FFFFFF;
		text-decoration: none;
		border-radius: 6px;
		padding: 10px 18px;
		font-family: 'Inter', sans-serif;
		font-weight: 600;
		font-size: 16px;
		transition: background-color 200ms ease;
	}

	.btn-primary-v2:hover {
		background-color: #B71C1C;
	}

	.btn-secondary-v2 {
		background-color: #14233F;
		color: #FFFFFF;
		text-decoration: none;
		border: 1px solid #41506B;
		border-radius: 6px;
		padding: 10px 18px;
		font-family: 'Inter', sans-serif;
		font-weight: 600;
		font-size: 16px;
		display: flex;
		align-items: center;
		gap: 6px;
		transition: filter 200ms ease;
	}

	.btn-secondary-v2:hover {
		filter: brightness(1.2);
	}

	.btn-secondary-v2 svg {
		color: #FFFFFF;
	}

	.hero-v2__image {
		position: absolute;
		right: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background-image: url('/images/aph_ambulance_rescue.png');
		background-size: cover;
		background-position: center right;
		z-index: 1;
	}

	.hero-v2__overlay {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(to right, #07111D 42%, transparent 100%);
	}

	@media (max-width: 992px) {
		.hero-v2__container {
			flex-direction: column;
			aspect-ratio: auto;
		}
		.hero-v2__image {
			position: absolute;
		}
		.hero-v2__overlay {
			background: linear-gradient(to right, #07111D 20%, transparent 100%);
			background-color: rgba(7, 17, 29, 0.7);
		}
		.hero-v2__content {
			width: 100%;
			max-width: 600px;
			padding: 40px 20px;
		}
	}

	@media (max-width: 768px) {
		.hero-v2__actions {
			flex-direction: column;
		}
		.btn-primary-v2, .btn-secondary-v2 {
			text-align: center;
			justify-content: center;
		}
	}
</style>
