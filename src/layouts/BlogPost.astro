---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props extends CollectionEntry<'blog'>['data'] {
	slug?: string;
}

const { title, description, pubDate, updatedDate, heroImage, slug } = Astro.props;

// Carrega todos os posts para listar os artigos relacionados
const allPosts = await getCollection('blog');

function getPostCategory(post: any): string {
	if (post.data?.category) return post.data.category;
	const pTitle = (post.data?.title || '').toLowerCase();
	const pSlug = (post.slug || '').toLowerCase();
	const pDesc = (post.data?.description || '').toLowerCase();
	const combined = `${pTitle} ${pSlug} ${pDesc}`;

	if (combined.includes('afogamento') || combined.includes('afogado') || combined.includes('resgate aquático') || combined.includes('água')) {
		return 'RESGATE AQUÁTICO';
	}
	if (combined.includes('guarda-vidas') || combined.includes('salvamento')) {
		return 'GUARDA-VIDAS';
	}
	if (combined.includes('protocolo') || combined.includes('passo a passo') || combined.includes('procedimento') || combined.includes('xabcde')) {
		return 'PROTOCOLOS';
	}
	if (combined.includes('hemorragia') || combined.includes('sangramento') || combined.includes('torniquete')) {
		return 'CONTROLE DE HEMORRAGIA';
	}
	if (combined.includes('curso') || combined.includes('capacitação') || combined.includes('treinamento') || combined.includes('formação')) {
		return 'CAPACITAÇÃO';
	}
	if (combined.includes('dea') || combined.includes('rcp') || combined.includes('parada') || combined.includes('reanimação')) {
		return 'SUPORTE À VIDA';
	}
	if (combined.includes('tático') || combined.includes('combate')) {
		return 'APH TÁTICO';
	}
	return 'PRIMEIROS SOCORROS';
}

const currentCategory = getPostCategory({ data: { title, description }, slug });

// Seleciona 3 posts relacionados (excluindo o atual)
const otherPosts = allPosts.filter(p => p.slug !== slug);
const sameCategoryPosts = otherPosts.filter(p => getPostCategory(p) === currentCategory);
const differentCategoryPosts = otherPosts.filter(p => getPostCategory(p) !== currentCategory);
const relatedPosts = [...sameCategoryPosts, ...differentCategoryPosts].slice(0, 3);

// Gera tags contextuais
function generateTags(): string[] {
	const tags: string[] = [];
	const text = `${title} ${description} ${currentCategory}`.toLowerCase();
	if (text.includes('afogamento') || text.includes('afogado')) tags.push('AFOGAMENTO', 'RESGATE AQUÁTICO');
	if (text.includes('guarda-vidas')) tags.push('GUARDA-VIDAS', 'SEGURANÇA AQUÁTICA');
	if (text.includes('protocolo') || text.includes('xabcde')) tags.push('PROTOCOLOS DE APH', 'ATENDIMENTO PRÉ-HOSPITALAR');
	if (text.includes('hemorragia') || text.includes('torniquete')) tags.push('CONTROLE DE HEMORRAGIA', 'STOP THE BLEED');
	if (text.includes('dea') || text.includes('rcp') || text.includes('reanimação')) tags.push('SUPORTE BÁSICO DE VIDA', 'RCP E DEA');
	if (text.includes('capacitação') || text.includes('treinamento') || text.includes('curso')) tags.push('FORMAÇÃO PROFISSIONAL', 'TREINAMENTO TÉCNICO');
	
	if (tags.length === 0) {
		tags.push('PRIMEIROS SOCORROS', 'APH', 'SALVAMENTO');
	}
	return Array.from(new Set(tags)).slice(0, 4);
}

const postTags = generateTags();
---

<Layout title={`${title} | Academia do Socorrista`} description={description}>
	<!-- Barra de progresso de leitura -->
	<div id="reading-progress-bar" class="reading-progress"></div>

	<Header />

	<!-- BARRA FLUTUANTE DE ADMIN (visível apenas quando logado) -->
	<aside id="blog-admin-bar" class="blog-admin-bar" style="display: none;" aria-label="Painel de controle do artigo">
		<div class="container admin-bar-container">
			<div class="admin-bar-left">
				<span class="admin-pulse-dot"></span>
				<span class="admin-label">Modo Edição Ativo</span>
				<span class="admin-badge">Admin</span>
			</div>
			<div class="admin-bar-right">
				{slug && (
					<a href={`/admin/artigos/editar?slug=${slug}`} class="admin-bar-btn highlight">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
						<span>Editar Este Artigo</span>
					</a>
				)}
				<a href="/admin/artigos" class="admin-bar-btn">Painel de Artigos</a>
				<a href="/blog" class="admin-bar-btn">Ver Todos os Posts</a>
			</div>
		</div>
	</aside>

	<!-- WRAPPER COM TEMA CLARO EDITORIAL REFINADO (#F7F5EE) -->
	<div class="single-article-wrapper">
		<div class="container">
			
			<!-- BREADCRUMBS & NAVEGAÇÃO -->
			<nav class="article-breadcrumb" aria-label="Navegação estrutural">
				<a href="/">Início</a>
				<span class="breadcrumb-sep">/</span>
				<a href="/blog">Blog</a>
				<span class="breadcrumb-sep">/</span>
				<span class="breadcrumb-current">{currentCategory}</span>
			</nav>

			<!-- CABEÇALHO DO ARTIGO -->
			<header class="article-main-header">
				<div class="article-meta-top">
					<span class="article-category-badge">{currentCategory}</span>
					<span class="article-read-time">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
						6 a 8 min de leitura
					</span>
					{slug && (
						<a href={`/admin/artigos/editar?slug=${slug}`} class="article-quick-edit-link" title="Editar artigo no Painel">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
							<span>Editar</span>
						</a>
					)}
				</div>

				<h1 class="article-title">{title}</h1>

				<div class="article-meta-bottom">
					<div class="author-info">
						<div class="author-avatar">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
						</div>
						<div class="author-text">
							<span class="author-name">Equipe Técnica • Academia do Socorrista</span>
							<time class="author-date" datetime={pubDate.toISOString()}>
								Publicado em {pubDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
								{updatedDate && ` • Atualizado em ${updatedDate.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}`}
							</time>
						</div>
					</div>
				</div>
			</header>

			<!-- ESTRUTURA PRINCIPAL: COLUNA DO ARTIGO + SIDEBAR STICKY -->
			<div class="article-body-layout">
				
				<!-- COLUNA PRINCIPAL DE CONTEÚDO (ESQUERDA) -->
				<main class="article-content-column">
					
					<!-- HERO IMAGE EM DESTAQUE -->
					{heroImage && (
						<figure class="article-hero-figure">
							<img 
								src={heroImage} 
								alt={title}
								class="article-hero-img"
								onerror="this.onerror=null; this.src='/blog/aph-ambulance-rescue.avif'" 
							/>
						</figure>
					)}

					<!-- CONTEÚDO EDITORIAL DO ARTIGO (MARKDOWN RENDERIZADO) -->
					<div class="article-prose-content">
						<slot />
					</div>

					<!-- RODAPÉ DO ARTIGO: TAGS & COMPARTILHAMENTO (IMAGEM 3) -->
					<footer class="article-post-footer">
						<div class="post-tags-wrapper">
							<span class="tags-label">TAGS:</span>
							<div class="tags-list">
								{postTags.map(tag => (
									<span class="tag-pill">#{tag}</span>
								))}
							</div>
						</div>

						<div class="post-share-wrapper">
							<span class="share-label">COMPARTILHAR:</span>
							<div class="share-buttons">
								<a 
									href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' - ' + (typeof window !== 'undefined' ? window.location.href : ''))}`} 
									target="_blank" 
									rel="noopener noreferrer" 
									class="share-btn share-whatsapp" 
									title="Compartilhar no WhatsApp"
									aria-label="WhatsApp"
								>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
								</a>
								<a 
									href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(typeof window !== 'undefined' ? window.location.href : '')}`} 
									target="_blank" 
									rel="noopener noreferrer" 
									class="share-btn share-linkedin" 
									title="Compartilhar no LinkedIn"
									aria-label="LinkedIn"
								>
									<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
								</a>
								<button 
									type="button" 
									id="btn-copy-link" 
									class="share-btn share-copy" 
									title="Copiar Link do Artigo"
									aria-label="Copiar Link"
								>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
								</button>
							</div>
						</div>
					</footer>

				</main>

				<!-- COLUNA LATERAL STICKY (DIREITA) -->
				<aside class="article-sidebar-column">
					<div class="sidebar-sticky-wrapper">
						
						<!-- CARD 1: SOBRE A INSTITUIÇÃO (ESTILO REFINADO IMAGEM 1/2) -->
						<div class="sidebar-card institution-card">
							<h3 class="sidebar-card-title">SOBRE A ACADEMIA</h3>
							<div class="title-gold-divider"></div>
							<p class="institution-desc">
								Referência nacional em capacitação técnica e treinamento avançado em APH, primeiros socorros, salvamento aquático e controle de hemorragias. Formamos socorristas preparados para agir quando vidas estão em jogo.
							</p>
							<a href="/nossos-cursos" class="institution-link">
								<span>CONHEÇA NOSSOS CURSOS</span>
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</a>
						</div>

						<!-- CARD 2: PRECISA DE AJUDA? (CARD ESCURO IMPACTANTE IMAGEM 1/2) -->
						<div class="sidebar-card cta-dark-card">
							<div class="cta-icon-circle">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							</div>
							<h3 class="cta-card-title">PRECISA DE AJUDA?</h3>
							<p class="cta-card-desc">
								Fale com nossos instrutores e tire suas dúvidas sobre protocolos, cursos e treinamentos práticos.
							</p>
							<a href="https://bitlybr.net/duvida" target="_blank" rel="noopener noreferrer" class="cta-gold-btn">
								<span>FALAR COM A EQUIPE</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
							</a>
						</div>

					</div>
				</aside>

			</div>

			<!-- SEÇÃO "ARTIGOS relacionados" (IMAGEM 3) -->
			{relatedPosts.length > 0 && (
				<section class="related-articles-section">
					<div class="related-section-header">
						<span class="related-eyebrow">CONTEÚDO RECOMENDADO</span>
						<h2 class="related-main-title">
							ARTIGOS <span class="serif-italic">relacionados</span>
						</h2>
					</div>

					<div class="related-grid">
						{relatedPosts.map(post => {
							const cat = getPostCategory(post);
							return (
								<article class="related-card">
									<a href={`/blog/${post.slug}/`} class="related-card-image-link" tabindex="-1" aria-hidden="true">
										<img 
											src={post.data.heroImage || '/blog/aph-ambulance-rescue.avif'} 
											alt={post.data.title}
											loading="lazy"
											onerror="this.onerror=null; this.src='/blog/aph-ambulance-rescue.avif'" 
										/>
									</a>
									<div class="related-card-body">
										<div class="related-card-tag">{cat}</div>
										<h3 class="related-card-title">
											<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
										</h3>
										<a href={`/blog/${post.slug}/`} class="related-card-cta">
											<span>LER ARTIGO</span>
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
										</a>
									</div>
								</article>
							);
						})}
					</div>
				</section>
			)}

		</div>
	</div>

	<!-- BANNER CTA PRÉ-FOOTER ESCURO (IMAGEM 3) -->
	<section class="pre-footer-cta-section">
		<div class="container pre-footer-cta-inner">
			<span class="pre-footer-eyebrow">PRONTO PARA SALVAR VIDAS?</span>
			<h2 class="pre-footer-headline">VAMOS CONSTRUIR O SEU CONHECIMENTO JUNTOS.</h2>
			<p class="pre-footer-subline">
				Entre em contato com nossos especialistas e receba uma orientação personalizada sobre nossas capacitações e treinamentos sem compromisso.
			</p>
			<a href="https://bitlybr.net/duvida" target="_blank" rel="noopener noreferrer" class="pre-footer-gold-btn">
				<span>FALAR COM A EQUIPE</span>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
			</a>
		</div>
	</section>

	<!-- TOAST NOTIFICATION DE LINK COPIADO -->
	<div id="copy-toast" class="copy-toast" role="status" aria-live="polite">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
		<span>Link copiado com sucesso!</span>
	</div>

	<Footer />
</Layout>

<style>
	/* ==========================================================================
	   BARRA DE PROGRESSO DE LEITURA
	   ========================================================================== */
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		width: 0%;
		background: #C88A2C;
		z-index: 9999;
		transition: width 0.1s ease-out;
	}

	/* ==========================================================================
	   CONTAINER PRINCIPAL COM TEMA CLARO EDITORIAL REFINADO (#F7F5EE)
	   ========================================================================== */
	.single-article-wrapper {
		background-color: #F7F5EE;
		color: #1E293B;
		padding: 130px 0 90px;
		min-height: 100vh;
	}

	/* BREADCRUMB */
	.article-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #8C7B65;
		margin-bottom: 24px;
	}

	.article-breadcrumb a {
		color: #8C7B65;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.article-breadcrumb a:hover {
		color: #C88A2C;
	}

	.breadcrumb-sep {
		opacity: 0.4;
	}

	.breadcrumb-current {
		color: #C88A2C;
	}

	/* CABEÇALHO DO ARTIGO */
	.article-main-header {
		margin-bottom: 36px;
	}

	.article-meta-top {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}

	.article-category-badge {
		background: #F5EBDC;
		color: #A86C23;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 5px 12px;
		border-radius: 4px;
	}

	.article-read-time {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #64748B;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.article-quick-edit-link {
		display: none;
		align-items: center;
		gap: 5px;
		background: #FDF4E7;
		border: 1px solid rgba(192, 106, 23, 0.3);
		color: #C06A17;
		padding: 4px 10px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.article-quick-edit-link:hover {
		background: #C06A17;
		color: #FFFFFF;
	}

	:global(body.is-admin) .article-quick-edit-link {
		display: inline-flex;
	}

	/* TÍTULO PRINCIPAL DO POST */
	.article-title {
		font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: 2.85rem;
		font-weight: 900;
		line-height: 1.18;
		color: #0F172A;
		letter-spacing: -0.025em;
		margin-bottom: 22px;
		max-width: 1050px;
	}

	/* METADADOS DO AUTOR E DATA */
	.article-meta-bottom {
		display: flex;
		align-items: center;
		padding-bottom: 26px;
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}

	.author-info {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.author-avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		background: #EAE4D5;
		color: #64748B;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.author-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.author-name {
		font-size: 0.88rem;
		font-weight: 700;
		color: #1E293B;
	}

	.author-date {
		font-size: 0.8rem;
		color: #64748B;
	}

	/* ==========================================================================
	   GRID DE 2 COLUNAS: ARTIGO (ESQ) + SIDEBAR (DIR)
	   ========================================================================== */
	.article-body-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 350px;
		gap: 50px;
		align-items: start;
		margin-bottom: 80px;
	}

	/* ==========================================================================
	   COLUNA PRINCIPAL: HERO + PROSE CONTENT
	   ========================================================================== */
	.article-content-column {
		min-width: 0;
	}

	/* HERO IMAGE COM CANTOS ARREDONDADOS E SOMBRA REFINADA */
	.article-hero-figure {
		margin: 0 0 36px 0;
		border-radius: 20px;
		overflow: hidden;
		background: #E2E8F0;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.06);
	}

	.article-hero-img {
		width: 100%;
		height: auto;
		max-height: 520px;
		object-fit: cover;
