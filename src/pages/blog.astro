---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Blog | Academia do Socorrista";
const description = "Leia artigos e dicas sobre APH, controle de hemorragias, resgate tático e primeiros socorros no blog oficial da Academia do Socorrista.";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={title} description={description}>
	<Header />

	<!-- BARRA FLUTUANTE DE ADMIN (visível quando logado como administrador) -->
	<aside id="blog-admin-bar" class="blog-admin-bar" style="display: none;" aria-label="Painel de controle do blog">
		<div class="container admin-bar-container">
			<div class="admin-bar-left">
				<span class="admin-pulse-dot"></span>
				<span class="admin-label">Modo Edição Ativo</span>
				<span class="admin-badge">Admin</span>
			</div>
			<div class="admin-bar-right">
				<a href="/admin/artigos/novo" class="admin-bar-btn highlight">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
					<span>Novo Artigo</span>
				</a>
				<a href="/admin/artigos" class="admin-bar-btn">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
					<span>Painel de Artigos</span>
				</a>
				<a href="/admin" class="admin-bar-btn">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
					<span>Painel Geral</span>
				</a>
			</div>
		</div>
	</aside>

	<main>
		<section class="page-hero">
			<div class="container animate-fade">
				<span class="section-badge">Insights & Dicas</span>
				<h1>Conhecimento que <span class="text-gradient">salva vidas!</span></h1>
				<p>Informação de qualidade e protocolos atualizados para profissionais e estudantes.</p>
			</div>
		</section>

		<section class="blog-grid-section">
			<div class="container">
				<div class="blog-grid">
					{posts.map((post, index) => (
						<article class="post-card glass-card animate-fade" style={`animation-delay: ${0.1 * (index % 6)}s`}>
							<div class="post-image-wrapper">
								<img 
									src={post.data.heroImage} 
									alt={post.data.title}
									loading="lazy"
									onerror="this.onerror=null; this.src='/blog/aph-ambulance-rescue.avif'" 
								/>
								<span class="category-badge">Emergência</span>
								
								<!-- Botão de edição direta no topo do card (visível para admins) -->
								<a 
									href={`/admin/artigos/editar?slug=${post.slug}`} 
									class="card-edit-overlay-btn" 
									title={`Editar artigo: ${post.data.title}`}
								>
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
									<span>Editar</span>
								</a>
							</div>
							<div class="post-content">
								<h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
								
								<div class="post-card-footer">
									<a href={`/blog/${post.slug}/`} class="read-more">Ler Artigo Completo →</a>
									<a 
										href={`/admin/artigos/editar?slug=${post.slug}`} 
										class="card-footer-edit-link" 
										title="Editar no painel"
									>
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
										<span>Editar</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
				
				<div class="load-more animate-fade">
					<a href="/cursos" class="btn btn-outline">Ver Nossos Cursos Oficiais</a>
				</div>
			</div>
		</section>
	</main>

	<!-- BOTÃO FLUTUANTE DE ATALHO RÁPIDO PARA ADMIN/EDIÇÃO -->
	<div class="blog-quick-access">
		<a id="btn-quick-admin" href="/admin/artigos" class="quick-admin-fab" title="Acessar Modo Edição / Gerenciador de Artigos">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
			<span class="fab-text">Modo Edição</span>
		</a>
	</div>

	<Footer />
</Layout>

<style>
	.page-hero {
		padding: 200px 0 100px;
		background: var(--dark-surface);
		text-align: center;
		border-bottom: 1px solid var(--glass-border);
	}

	.page-hero h1 {
		font-size: 4rem;
		margin-bottom: 20px;
	}

	.page-hero p {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.blog-grid-section {
		padding: 120px 0;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 30px;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		padding: 0;
		overflow: hidden;
		position: relative;
		transition: var(--transition);
	}

	.post-card:hover { 
		transform: translateY(-8px); 
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
	}

	.post-image-wrapper {
		position: relative;
		height: 240px;
		overflow: hidden;
	}

	.post-image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.post-card:hover .post-image-wrapper img { 
		transform: scale(1.06); 
	}

	.category-badge {
		position: absolute;
		top: 16px;
		right: 16px;
		background: var(--primary);
		color: var(--dark);
		padding: 6px 14px;
		border-radius: 100px;
		font-weight: 700;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		z-index: 2;
	}

	/* Botão de edição em overlay no topo do card */
	.card-edit-overlay-btn {
		display: none;
		position: absolute;
		top: 16px;
		left: 16px;
		background: rgba(18, 22, 28, 0.9);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 85, 0, 0.5);
		color: #ff8533;
		padding: 5px 12px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		align-items: center;
		gap: 5px;
		z-index: 2;
		transition: all 0.2s ease;
	}

	.card-edit-overlay-btn:hover {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(255, 85, 0, 0.4);
	}

	:global(body.is-admin) .card-edit-overlay-btn {
		display: inline-flex;
	}

	.post-content {
		padding: 30px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.post-content h3 {
		font-size: 1.35rem;
		margin-bottom: 18px;
		line-height: 1.4;
	}

	.post-content h3 a {
		color: white;
		text-decoration: none;
		transition: var(--transition);
	}

	.post-content h3 a:hover { 
		color: var(--primary); 
	}

	.post-content p {
		color: var(--text-muted);
		font-size: 0.95rem;
		margin-bottom: 25px;
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.post-card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 15px;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	.read-more {
		color: var(--primary);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
		transition: var(--transition);
	}

	.read-more:hover { 
		gap: 15px; 
		padding-left: 4px; 
	}

	.card-footer-edit-link {
		display: none;
		align-items: center;
		gap: 5px;
		color: #ff8533;
		background: rgba(255, 85, 0, 0.1);
		border: 1px solid rgba(255, 85, 0, 0.25);
		padding: 4px 10px;
		border-radius: 6px;
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.card-footer-edit-link:hover {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
	}

	:global(body.is-admin) .card-footer-edit-link {
		display: inline-flex;
	}

	.load-more {
		text-align: center;
		margin-top: 70px;
	}

	/* Barra superior flutuante de administração */
	.blog-admin-bar {
		position: sticky;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: rgba(18, 22, 28, 0.96);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(255, 85, 0, 0.35);
		padding: 10px 0;
		box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5);
	}

	.admin-bar-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 15px;
		flex-wrap: wrap;
	}

	.admin-bar-left {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.admin-pulse-dot {
		width: 8px;
		height: 8px;
		background: #10b981;
		border-radius: 50%;
		box-shadow: 0 0 10px #10b981;
		animation: pulse-green 2s infinite;
	}

	@keyframes pulse-green {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(1.3); }
	}

	.admin-label {
		font-size: 0.82rem;
		font-weight: 700;
		color: #f3f4f6;
		letter-spacing: 0.03em;
	}

	.admin-badge {
		background: rgba(255, 85, 0, 0.2);
		border: 1px solid rgba(255, 85, 0, 0.4);
		color: #ff8533;
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.admin-bar-right {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.admin-bar-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #d1d5db;
		padding: 6px 14px;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.admin-bar-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.25);
	}

	.admin-bar-btn.highlight {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
	}

	.admin-bar-btn.highlight:hover {
		background: #ff6a1a;
		box-shadow: 0 4px 14px rgba(255, 85, 0, 0.4);
	}

	/* Botão flutuante FAB */
	.blog-quick-access {
		position: fixed;
		bottom: 24px;
		right: 24px;
		z-index: 99;
	}

	.quick-admin-fab {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(24, 28, 35, 0.9);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 85, 0, 0.4);
		color: #ff8533;
		padding: 10px 18px;
		border-radius: 999px;
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
		transition: all 0.3s ease;
	}

	.quick-admin-fab:hover {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(255, 85, 0, 0.4);
	}

	:global(body.is-admin) .quick-admin-fab .fab-text {
		content: "Painel Admin";
	}

	@media (max-width: 768px) {
		.page-hero h1 { font-size: 3rem; }
		.admin-bar-container { flex-direction: column; align-items: flex-start; }
		.quick-admin-fab .fab-text { display: none; }
		.quick-admin-fab { padding: 12px; }
	}
</style>

<script>
	async function checkAdminMode() {
		try {
			// Permite ativar o modo de visualização com edição via querystring ?edit=1 ou ?admin=1
			const urlParams = new URLSearchParams(window.location.search);
			const forceEdit = urlParams.has('edit') || urlParams.has('admin');

			const res = await fetch('/api/admin/auth-status', { credentials: 'include' });
			let isAuthenticated = false;

			if (res.ok) {
				const data = await res.json();
				isAuthenticated = Boolean(data.authenticated);
			}

			if (isAuthenticated || forceEdit) {
				document.body.classList.add('is-admin');
				const bar = document.getElementById('blog-admin-bar');
				if (bar) bar.style.display = 'block';

				const fab = document.getElementById('btn-quick-admin');
				if (fab) {
					fab.setAttribute('href', '/admin/artigos');
					const text = fab.querySelector('.fab-text');
					if (text) text.textContent = 'Painel de Artigos';
				}
			} else {
				// Se não estiver logado, o botão flutuante aponta para login com redirect
				const fab = document.getElementById('btn-quick-admin');
				if (fab) {
					fab.setAttribute('href', '/admin/login?redirect=' + encodeURIComponent(window.location.pathname));
					const text = fab.querySelector('.fab-text');
					if (text) text.textContent = 'Modo Edição';
				}
			}
		} catch (e) {
			// Silencioso se offline
		}
	}

	checkAdminMode();
</script>
