---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Blog | Academia do Socorrista";
const description = "Leia artigos e dicas sobre APH, controle de hemorragias, resgate tático e primeiros socorros no blog oficial da Academia do Socorrista.";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function getPostCategory(post: any): string {
	if (post.data.category) return post.data.category;
	const title = (post.data.title || '').toLowerCase();
	const slug = (post.slug || '').toLowerCase();
	const desc = (post.data.description || '').toLowerCase();
	const combined = `${title} ${slug} ${desc}`;

	if (combined.includes('afogamento') || combined.includes('afogado') || combined.includes('resgate aquático') || combined.includes('água')) {
		return 'RESGATE AQUÁTICO';
	}
	if (combined.includes('guarda-vidas') || combined.includes('salvamento')) {
		return 'GUARDA-VIDAS';
	}
	if (combined.includes('protocolo') || combined.includes('passo a passo') || combined.includes('procedimento')) {
		return 'PROTOCOLOS';
	}
	if (combined.includes('hemorragia') || combined.includes('sangramento') || combined.includes('torniquete')) {
		return 'CONTROLE DE HEMORRAGIA';
	}
	if (combined.includes('curso') || combined.includes('capacitação') || combined.includes('treinamento') || combined.includes('formação')) {
		return 'CAPACITAÇÃO';
	}
	if (combined.includes('dea') || combined.includes('rcp') || combined.includes('parada') || combined.includes('reanimação')) {
		return 'SUPORTE À VIDA';
	}
	if (combined.includes('tático') || combined.includes('combate')) {
		return 'APH TÁTICO';
	}
	return 'PRIMEIROS SOCORROS';
}
---

<Layout title={title} description={description}>
	<Header />

	<!-- BARRA FLUTUANTE DE ADMIN (visível quando logado como administrador) -->
	<aside id="blog-admin-bar" class="blog-admin-bar" style="display: none;" aria-label="Painel de controle do blog">
		<div class="container admin-bar-container">
			<div class="admin-bar-left">
				<span class="admin-pulse-dot"></span>
				<span class="admin-label">Modo Edição Ativo</span>
				<span class="admin-badge">Admin</span>
			</div>
			<div class="admin-bar-right">
				<a href="/admin/artigos/novo" class="admin-bar-btn highlight">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
					<span>Novo Artigo</span>
				</a>
				<a href="/admin/artigos" class="admin-bar-btn">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
					<span>Painel de Artigos</span>
				</a>
				<a href="/admin" class="admin-bar-btn">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
					<span>Painel Geral</span>
				</a>
			</div>
		</div>
	</aside>

	<main>
		<!-- HERO SECTION (ESTILO ORIGINAL ESCURO) -->
		<section class="page-hero">
			<div class="container animate-fade">
				<span class="section-badge">Insights & Dicas</span>
				<h1>Conhecimento que <span class="text-gradient">salva vidas!</span></h1>
				<p>Informação de qualidade e protocolos atualizados para profissionais e estudantes.</p>
			</div>
		</section>

		<!-- SEÇÃO DE CARDS DO BLOG (ESTILO CLARO/EDITORIAL REFINADO) -->
		<section class="blog-grid-section">
			<div class="container">
				<div class="blog-grid">
					{posts.map((post, index) => {
						const category = getPostCategory(post);
						return (
							<article class="post-card animate-fade" style={`animation-delay: ${0.08 * (index % 6)}s`}>
								<div class="post-image-wrapper">
									<a href={`/blog/${post.slug}/`} class="post-image-link" tabindex="-1" aria-hidden="true">
										<img 
											src={post.data.heroImage || '/blog/aph-ambulance-rescue.avif'} 
											alt={post.data.title}
											loading="lazy"
											onerror="this.onerror=null; this.src='/blog/aph-ambulance-rescue.avif'" 
										/>
									</a>
									
									<!-- Botão de edição direta no topo do card (visível para admins) -->
									<a 
										href={`/admin/artigos/editar?slug=${post.slug}`} 
										class="card-edit-overlay-btn" 
										title={`Editar artigo: ${post.data.title}`}
									>
										<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
										<span>Editar</span>
									</a>
								</div>

								<div class="post-content">
									<div class="post-category-tag">{category}</div>

									<h2 class="post-title">
										<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
									</h2>

									<p class="post-description">{post.data.description}</p>
									
									<div class="post-card-footer">
										<a href={`/blog/${post.slug}/`} class="read-more">
											<span>LER MAIS</span>
										</a>
										<a 
											href={`/admin/artigos/editar?slug=${post.slug}`} 
											class="card-footer-edit-link" 
											title="Editar no painel"
										>
											<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
											<span>Editar</span>
										</a>
									</div>
								</div>
							</article>
						);
					})}
				</div>
				
				<div class="load-more animate-fade">
					<a href="/cursos" class="btn-courses-cta">
						<span>Ver Nossos Cursos Oficiais</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</a>
				</div>
			</div>
		</section>
	</main>

	<!-- BOTÃO FLUTUANTE DE ATALHO RÁPIDO PARA ADMIN/EDIÇÃO -->
	<div class="blog-quick-access">
		<a id="btn-quick-admin" href="/admin/artigos" class="quick-admin-fab" title="Acessar Modo Edição / Gerenciador de Artigos">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
			<span class="fab-text">Modo Edição</span>
		</a>
	</div>

	<Footer />
</Layout>

<style>
	/* ==========================================================================
	   HERO (MANTÉM O VISUAL ESCURO DA IMAGEM 2)
	   ========================================================================== */
	.page-hero {
		padding: 180px 0 90px;
		background: #051429;
		background: radial-gradient(circle at top center, rgba(14, 34, 61, 0.8) 0%, #051429 80%);
		text-align: center;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		position: relative;
	}

	.section-badge {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		color: #94a3b8;
		letter-spacing: 0.05em;
		margin-bottom: 14px;
	}

	.page-hero h1 {
		font-size: 3.8rem;
		font-weight: 800;
		color: #ffffff;
		margin-bottom: 18px;
		letter-spacing: -0.025em;
		line-height: 1.15;
	}

	.page-hero p {
		font-size: 1.18rem;
		color: #94a3b8;
		max-width: 640px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* ==========================================================================
	   SEÇÃO DE CARDS APÓS O HERO (ESTILO CLARO/EDITORIAL DA IMAGEM 1)
	   ========================================================================== */
	.blog-grid-section {
		background-color: #F7F5EE;
		padding: 80px 0 110px;
		position: relative;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}

	/* CARD INDIVIDUAL */
	.post-card {
		background: #FFFFFF;
		border-radius: 18px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.03);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
	}

	.post-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 18px 38px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.03);
	}

	/* IMAGEM DO CARD */
	.post-image-wrapper {
		position: relative;
		height: 230px;
		overflow: hidden;
		background: #E5E7EB;
	}

	.post-image-link {
		display: block;
		width: 100%;
		height: 100%;
	}

	.post-image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.post-card:hover .post-image-wrapper img {
		transform: scale(1.05);
	}

	/* BOTÃO DE EDIÇÃO OVERLAY (ADMIN) */
	.card-edit-overlay-btn {
		display: none;
		position: absolute;
		top: 14px;
		left: 14px;
		background: rgba(18, 22, 28, 0.88);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 94, 0, 0.5);
		color: #ff8533;
		padding: 5px 12px;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		align-items: center;
		gap: 5px;
		z-index: 2;
		transition: all 0.2s ease;
	}

	.card-edit-overlay-btn:hover {
		background: #FF5E00;
		color: #FFFFFF;
		border-color: #FF5E00;
		transform: translateY(-1px);
	}

	:global(body.is-admin) .card-edit-overlay-btn {
		display: inline-flex;
	}

	/* CONTEÚDO DO CARD */
	.post-content {
		padding: 26px 26px 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	/* TAG DE CATEGORIA (ESTILO EXATO DA IMAGEM DE REFERÊNCIA) */
	.post-category-tag {
		align-self: flex-start;
		background: #F5EBDC;
		color: #A86C23;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 4px;
		margin-bottom: 14px;
		line-height: 1.3;
	}

	/* TÍTULO DO CARD (EM CAIXA ALTA, SANS-SERIF MODERNA, IMPACTANTE) */
	.post-title {
		font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		font-size: 1.15rem;
		font-weight: 900;
		line-height: 1.35;
		text-transform: uppercase;
		letter-spacing: -0.01em;
		margin-bottom: 14px;
		color: #0F172A;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 4.05em;
	}

	.post-title a {
		color: #0F172A;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.post-title a:hover {
		color: #A86C23;
	}

	/* DESCRIÇÃO / EXCERTO */
	.post-description {
		color: #556272;
		font-size: 0.88rem;
		line-height: 1.62;
		margin-bottom: 24px;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	/* RODAPÉ DO CARD */
	.post-card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding-top: 14px;
		border-top: 1px solid rgba(0, 0, 0, 0.05);
	}

	/* BOTÃO LER MAIS (ESTILO EXATO DA FOTO) */
	.read-more {
		color: #A86C23;
		text-decoration: none;
		font-weight: 800;
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.read-more:hover {
		color: #8C5413;
		transform: translateX(3px);
	}

	/* BOTÃO DE EDIÇÃO NO RODAPÉ DO CARD (ADMIN) */
	.card-footer-edit-link {
		display: none;
		align-items: center;
		gap: 4px;
		color: #C06A17;
		background: #FDF4E7;
		border: 1px solid rgba(192, 106, 23, 0.25);
		padding: 4px 9px;
		border-radius: 6px;
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.card-footer-edit-link:hover {
		background: #C06A17;
		color: #FFFFFF;
	}

	:global(body.is-admin) .card-footer-edit-link {
		display: inline-flex;
	}

	/* BOTÃO CTA INFERIOR "VER NOSSOS CURSOS OFICIAIS" */
	.load-more {
		text-align: center;
		margin-top: 60px;
	}

	.btn-courses-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		background: #0F172A;
		color: #FFFFFF;
		padding: 15px 36px;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		letter-spacing: 0.02em;
		box-shadow: 0 4px 18px rgba(15, 23, 42, 0.15);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-courses-cta:hover {
		background: #FF5E00;
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(255, 94, 0, 0.35);
	}

	/* ==========================================================================
	   BARRA FLUTUANTE DE ADMIN
	   ========================================================================== */
	.blog-admin-bar {
		position: sticky;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: rgba(18, 22, 28, 0.96);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(255, 85, 0, 0.35);
		padding: 10px 0;
		box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5);
	}

	.admin-bar-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 15px;
		flex-wrap: wrap;
	}

	.admin-bar-left {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.admin-pulse-dot {
		width: 8px;
		height: 8px;
		background: #10b981;
		border-radius: 50%;
		box-shadow: 0 0 10px #10b981;
		animation: pulse-green 2s infinite;
	}

	@keyframes pulse-green {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(1.3); }
	}

	.admin-label {
		font-size: 0.82rem;
		font-weight: 700;
		color: #f3f4f6;
		letter-spacing: 0.03em;
	}

	.admin-badge {
		background: rgba(255, 85, 0, 0.2);
		border: 1px solid rgba(255, 85, 0, 0.4);
		color: #ff8533;
		padding: 2px 8px;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.admin-bar-right {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.admin-bar-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #d1d5db;
		padding: 6px 14px;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.admin-bar-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.25);
	}

	.admin-bar-btn.highlight {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
	}

	.admin-bar-btn.highlight:hover {
		background: #ff6a1a;
		box-shadow: 0 4px 14px rgba(255, 85, 0, 0.4);
	}

	/* BOTÃO FLUTUANTE FAB */
	.blog-quick-access {
		position: fixed;
		bottom: 24px;
		right: 24px;
		z-index: 99;
	}

	.quick-admin-fab {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(24, 28, 35, 0.9);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 85, 0, 0.4);
		color: #ff8533;
		padding: 10px 18px;
		border-radius: 999px;
		font-size: 0.84rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
		transition: all 0.3s ease;
	}

	.quick-admin-fab:hover {
		background: #ff5500;
		color: #ffffff;
		border-color: #ff5500;
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(255, 85, 0, 0.4);
	}

	/* RESPONSIVIDADE */
	@media (max-width: 1080px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 26px;
		}
	}

	@media (max-width: 768px) {
		.page-hero {
			padding: 140px 0 60px;
		}
		.page-hero h1 { 
			font-size: 2.6rem; 
		}
		.blog-grid-section {
			padding: 50px 0 80px;
		}
		.blog-grid {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.post-title {
			min-height: auto;
		}
		.admin-bar-container { 
			flex-direction: column; 
			align-items: flex-start; 
		}
		.quick-admin-fab .fab-text { 
			display: none; 
		}
		.quick-admin-fab { 
			padding: 12px; 
		}
	}
</style>

<script>
	async function checkAdminMode() {
		try {
			// Permite ativar o modo de visualização com edição via querystring ?edit=1 ou ?admin=1
			const urlParams = new URLSearchParams(window.location.search);
			const forceEdit = urlParams.has('edit') || urlParams.has('admin');

			const res = await fetch('/api/admin/auth-status', { credentials: 'include' });
			let isAuthenticated = false;

			if (res.ok) {
				const data = await res.json();
				isAuthenticated = Boolean(data.authenticated);
			}

			if (isAuthenticated || forceEdit) {
				document.body.classList.add('is-admin');
				const bar = document.getElementById('blog-admin-bar');
				if (bar) bar.style.display = 'block';

				const fab = document.getElementById('btn-quick-admin');
				if (fab) {
					fab.setAttribute('href', '/admin/artigos');
					const text = fab.querySelector('.fab-text');
					if (text) text.textContent = 'Painel de Artigos';
				}
			} else {
				// Se não estiver logado, o botão flutuante aponta para login com redirect
				const fab = document.getElementById('btn-quick-admin');
				if (fab) {
					fab.setAttribute('href', '/admin/login?redirect=' + encodeURIComponent(window.location.pathname));
					const text = fab.querySelector('.fab-text');
					if (text) text.textContent = 'Modo Edição';
				}
			}
		} catch (e) {
			// Silencioso se offline
		}
	}

	checkAdminMode();
</script>
