---
import Layout from '../layouts/Layout.astro';

const title = "Helber Braga | Academia do Socorrista";
const description = "Bombeiro, Instrutor de guarda-vidas, Especialista em Urgência, Emergência e APH.";

const links = [
	{
		url: "/domine-o-controle-de-hemorragias",
		img: "/images/banner-controle-de-hemorragia.jpg",
		alt: "Domine o Controle de Hemorragias",
		newTab: true
	},
	{
		url: "/recuperacao-de-afogados-na-pratica",
		img: "/images/saiba-mais-4-1.png",
		alt: "Recuperação de Afogados na Prática",
		newTab: true
	},
	{
		url: "https://profissaoguardavidas.com.br/",
		img: "/images/comprar-produtos.jpg",
		alt: "Comprar Produtos"
	},
	{
		url: "https://www.tiktok.com/@hbragaa",
		img: "/images/tiktok_.jpg",
		alt: "TikTok"
	},
	{
		url: "https://www.instagram.com/hbragaa/",
		img: "/images/instagram.jpg",
		alt: "Instagram"
	},
	{
		url: "https://wa.me/+5548988551045?text=Ol%C3%A1%2C%20",
		img: "/images/whatsapp_.jpg",
		alt: "WhatsApp"
	}
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<!-- Favicon opcional -->
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			background-color: #F3F4F6; /* Cor de fundo clarinha similar ao original */
			display: flex;
			justify-content: center;
			min-height: 100vh;
		}

		.bio-container {
			width: 100%;
			max-width: 480px; /* Largura típica de celular */
			background-color: #ffffff; /* Fundo branco para a área principal se necessário, ou manter transparente */
			min-height: 100vh;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: 40px 20px;
			box-shadow: 0 0 20px rgba(0,0,0,0.05); /* Sombra suave lateral */
		}

		.profile-img-wrapper {
			width: 120px;
			height: 120px;
			margin-bottom: 15px;
			border-radius: 50%;
			overflow: hidden;
			box-shadow: 0 4px 10px rgba(0,0,0,0.1); /* Sombra na foto */
		}

		.profile-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.profile-name {
			font-size: 1.5rem;
			font-weight: 700;
			color: #333;
			margin-bottom: 5px;
			text-align: center;
		}

		.profile-bio {
			font-size: 0.95rem;
			color: #666;
			text-align: center;
			margin-bottom: 30px;
			line-height: 1.4;
		}

		.links-list {
			width: 100%;
			display: flex;
			flex-direction: column;
			gap: 15px;
		}

		.link-item {
			width: 100%;
			display: block;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
			border-radius: 12px;
			overflow: hidden;
			/* Se os banners já tiverem borda arredondada na imagem em si, não precisa do border-radius, mas é bom garantir */
			box-shadow: 0 2px 8px rgba(0,0,0,0.08);
		}

		.link-item:hover {
			transform: scale(1.02);
			box-shadow: 0 6px 15px rgba(0,0,0,0.15);
		}

		.link-img {
			width: 100%;
			display: block; /* Remove espaçamento abaixo da imagem */
			height: auto;
		}

	</style>
</head>
<body>
	<main class="bio-container">
		<div class="profile-img-wrapper">
			<img src="/images/Helber-Braga-links.png" alt="Helber Braga" class="profile-img">
		</div>
		
		<h1 class="profile-name">Helber Braga</h1>
		<p class="profile-bio">
			🚒 Bombeiro<br>
			🏊🏽‍♂️ Salvamento aquático #VAIQUEDEU<br>
			🪢 Salvamento em altura<br>
			🎓 Especialista em Urgência, Emergência e APH
		</p>

		<div class="links-list">
			{links.map(link => (
				<a href={link.url} class="link-item" target={link.url.startsWith('http') || link.newTab ? '_blank' : '_self'} rel={link.url.startsWith('http') || link.newTab ? 'noopener noreferrer' : ''}>
					<img src={link.img} alt={link.alt} class="link-img" />
				</a>
			))}
		</div>
	</main>
</body>
</html>

