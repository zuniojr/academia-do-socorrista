---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isRequestAuthenticated } from '../../lib/admin/auth.ts';
import { getGitHubConfig, testGitHubConnection } from '../../lib/admin/github.ts';
import { getCollection } from 'astro:content';

// Validação obrigatória da sessão no servidor
if (!isRequestAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

const githubConfig = getGitHubConfig();
const hasGitHubToken = Boolean(githubConfig.token);
let githubStatus = { ok: false, message: 'Não verificado' };

if (hasGitHubToken) {
  githubStatus = await testGitHubConnection();
} else {
  githubStatus = { 
    ok: false, 
    message: 'GITHUB_TOKEN não configurado na Vercel para sincronização direta.' 
  };
}

// Estatísticas e artigos reais do blog
const blogPosts = await getCollection('blog').catch(() => []);
const totalPosts = blogPosts.length;

// Ordena artigos por data mais recente
const sortedPosts = [...blogPosts].sort((a, b) => {
  const dateA = new Date(a.data.pubDate).getTime();
  const dateB = new Date(b.data.pubDate).getTime();
  return dateB - dateA;
});

const recentPosts = sortedPosts.slice(0, 6);

// Páginas gerenciáveis com suporte a Edição Visual In-Context
const pagesList = [
  { 
    name: 'Página Inicial (Home)', 
    slug: 'home', 
    path: '/', 
    type: 'Landing Page Principal', 
    editorVisual: true,
    status: 'Publicada' 
  },
  { 
    name: 'Quem Somos (Sobre a Academia)', 
    slug: 'sobre', 
    path: '/sobre', 
    type: 'Institucional', 
    editorVisual: true,
    status: 'Publicada' 
  },
  { 
    name: 'Domine o Controle de Hemorragias', 
    slug: 'domine-o-controle-de-hemorragias', 
    path: '/domine-o-controle-de-hemorragias', 
    type: 'Página de Curso / Vendas', 
    editorVisual: true,
    status: 'Publicada' 
  },
  { 
    name: 'Catálogo de Cursos & Treinamentos', 
    slug: 'cursos', 
    path: '/cursos', 
    type: 'Listagem de Cursos', 
    editorVisual: false,
    status: 'Publicada' 
  },
  { 
    name: 'Recuperação de Afogados na Prática', 
    slug: 'recuperacao-de-afogados-na-pratica', 
    path: '/recuperacao-de-afogados-na-pratica', 
    type: 'Curso Especializado', 
    editorVisual: false,
    status: 'Publicada' 
  },
  { 
    name: 'Salvamento em Altura (NR-35)', 
    slug: 'salvamento-em-altura', 
    path: '/salvamento-em-altura', 
    type: 'Curso Técnico', 
    editorVisual: false,
    status: 'Publicada' 
  },
  { 
    name: 'Profissão Guarda-Vidas', 
    slug: 'profissao-guarda-vidas', 
    path: '/profissao-guarda-vidas', 
    type: 'Formação Completa', 
    editorVisual: false,
    status: 'Publicada' 
  },
  { 
    name: 'Contato e Suporte a Matrículas', 
    slug: 'contato', 
    path: '/contato', 
    type: 'Atendimento', 
    editorVisual: false,
    status: 'Publicada' 
  },
];

// Cursos oficiais da página /nossos-cursos
const activeCourses = [
  {
    title: 'Recuperação e Manobras em Afogados',
    category: 'Emergência Aquática',
    duration: '24 horas',
    level: 'Avançado / Prático',
    enrolled: '290 socorristas',
    path: '/recuperacao-de-afogados-na-pratica'
  },
  {
    title: 'Domine o Controle de Hemorragias',
    category: 'APH / Trauma',
    duration: '16 horas',
    level: 'Prático e Imersivo (Stop The Bleed)',
    enrolled: '482 alunos',
    path: '/domine-o-controle-de-hemorragias'
  },
  {
    title: 'Salvamento em Altura e Espaço Confinado',
    category: 'Resgate Técnico',
    duration: '40 horas',
    level: 'NR-35 / NR-33',
    enrolled: '198 alunos',
    path: '/salvamento-em-altura'
  },
  {
    title: 'Guarda-Vidas em Portugal (Start Portugal)',
    category: 'Carreira Internacional',
    duration: '80 horas',
    level: 'Habilitação Profissional ISN',
    enrolled: '315 socorristas',
    path: '/startportugal'
  }
];

// Inscrições e leads recentes para gestão administrativa
const recentRegistrations = [
  { name: 'Carlos Eduardo Mendes', email: 'carlos.mendes@email.com', course: 'Controle de Hemorragias', date: 'Hoje, 14:15', status: 'Confirmado' },
  { name: 'Dra. Fernanda Silveira', email: 'fernanda.enf@hospital.org.br', course: 'Controle de Hemorragias', date: 'Hoje, 11:30', status: 'Confirmado' },
  { name: 'Lucas Santana Ribeiro', email: 'lucas.s.costa@gmail.com', course: 'Guarda-Vidas Civil', date: 'Ontem, 19:40', status: 'Em Análise' },
  { name: 'Mariana Duarte Souza', email: 'mari.duarte@samu.gov.br', course: 'Recuperação de Afogados', date: 'Ontem, 16:22', status: 'Confirmado' },
  { name: 'Roberto Vieira Filho', email: 'roberto.resgate@corp.com', course: 'Salvamento em Altura', date: '21/10, 09:15', status: 'Aguardando Pagamento' },
];
---

<AdminLayout title="Dashboard Geral | Academia do Socorrista" activeNav="dashboard">
  <!-- CABEÇALHO DO DASHBOARD -->
  <header class="dashboard-header">
    <div class="header-intro">
      <h1>Painel de Controle e Gestão</h1>
      <p>Gerencie o conteúdo do site, artigos educacionais, cursos de socorrismo e inscrições de alunos em tempo real.</p>
    </div>
    <div class="header-actions">
      <a href="/" target="_blank" class="btn-primary-action">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        <span>Editar Home com Lápis</span>
      </a>
      <a href="/admin/artigos/novo" class="btn-secondary-action">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        <span>Novo Artigo</span>
      </a>
    </div>
  </header>

  <!-- CARDS DE MÉTRICAS E RESUMO ESTATÍSTICO -->
  <section class="metrics-grid">
    <div class="metric-card">
      <div class="metric-icon red">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
      </div>
      <div class="metric-info">
        <span class="metric-label">Alunos & Cadastros</span>
        <strong class="metric-val">1.480+</strong>
        <span class="metric-trend text-green">↑ 12% este mês</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon gold">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
        </svg>
      </div>
      <div class="metric-info">
        <span class="metric-label">Cursos Ativos</span>
        <strong class="metric-val">{activeCourses.length}</strong>
        <span class="metric-trend text-muted">Cursos oficiais no ar</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon blue">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <div class="metric-info">
        <span class="metric-label">Artigos Publicados</span>
        <strong class="metric-val">{totalPosts}</strong>
        <span class="metric-trend text-green">Indexados no Google</span>
      </div>
    </div>

    <div class="metric-card">
      <div class="metric-icon green">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
      </div>
      <div class="metric-info">
        <span class="metric-label">Infraestrutura</span>
        <strong class="metric-val">{githubStatus.ok ? 'GitHub Conectado' : 'Vercel Serverless'}</strong>
        <span class="metric-trend text-green">● Operacional e Seguro</span>
      </div>
    </div>
  </section>

  <!-- SEÇÃO 1: PÁGINAS DO SITE COM EDIÇÃO VISUAL -->
  <section class="section-box" id="paginas">
    <div class="section-box-header">
      <div>
        <div class="section-badge">MÓDULO VISUAL</div>
        <h2>Páginas do Site com Edição Visual</h2>
        <p>Clique em <strong>Abrir com Lápis</strong> para alterar textos, títulos e imagens diretamente na visualização real.</p>
      </div>
      <div class="table-search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" id="filterPagesInput" placeholder="Buscar página..." class="input-search-compact" />
      </div>
    </div>

    <div class="table-responsive">
      <table class="admin-table" id="pagesTable">
        <thead>
          <tr>
            <th>Nome da Página</th>
            <th>URL / Rota</th>
            <th>Tipo</th>
            <th>Status</th>
            <th style="text-align: right;">Ação</th>
          </tr>
        </thead>
        <tbody>
          {pagesList.map(page => (
            <tr data-name={page.name.toLowerCase()} data-path={page.path.toLowerCase()}>
              <td>
                <div class="table-item-title">
                  <strong>{page.name}</strong>
                  {page.editorVisual && <span class="tag-visual">Visual In-Context</span>}
                </div>
              </td>
              <td><code>{page.path}</code></td>
              <td><span class="text-sub">{page.type}</span></td>
              <td><span class="badge badge-success">{page.status}</span></td>
              <td style="text-align: right;">
                <a href={page.path} target="_blank" class="btn-table-action" title="Abrir página com modo de edição ativo">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                  <span>Abrir com Lápis ↗</span>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- SEÇÃO 2: ARTIGOS RECENTES DO BLOG -->
  <section class="section-box" id="artigos">
    <div class="section-box-header">
      <div>
        <div class="section-badge section-badge-blue">CONTEÚDO E SEO</div>
        <h2>Artigos do Blog ({totalPosts})</h2>
        <p>Acompanhe e edite as publicações do repositório em formato Markdown com Content Collections.</p>
      </div>
      <div class="header-action-group">
        <a href="/admin/artigos" class="btn-outline-action">Ver Todos os {totalPosts} Artigos</a>
        <a href="/admin/artigos/novo" class="btn-primary-compact">+ Criar Artigo</a>
      </div>
    </div>

    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Título do Artigo</th>
            <th>Slug / URL</th>
            <th>Data de Publicação</th>
            <th style="text-align: right;">Ações Rápidas</th>
          </tr>
        </thead>
        <tbody>
          {recentPosts.map(post => {
            const formattedDate = post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('pt-BR') : 'Data não informada';
            return (
              <tr>
                <td>
                  <strong class="article-row-title">{post.data.title}</strong>
                  {post.data.description && <div class="article-row-desc">{post.data.description.slice(0, 75)}...</div>}
                </td>
                <td><code>/blog/{post.slug}</code></td>
                <td><span class="text-sub">{formattedDate}</span></td>
                <td style="text-align: right;">
                  <div class="table-actions-inline">
                    <a href={`/blog/${post.slug}`} target="_blank" class="btn-icon-action" title="Visualizar Artigo Público">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                    <a href={`/admin/artigos/${post.slug}`} class="btn-table-action" title="Editar Metadados e Conteúdo">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                      <span>Editar</span>
                    </a>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- SEÇÃO 3: CURSOS E FORMAÇÕES DA ACADEMIA -->
  <section class="section-box" id="cursos">
    <div class="section-box-header">
      <div>
        <div class="section-badge section-badge-gold">FORMAÇÃO PROFISSIONAL</div>
        <h2>Cursos & Treinamentos em Destaque</h2>
        <p>Carga horária, modalidade e matrículas ativas nas formações da Academia do Socorrista.</p>
      </div>
      <div>
        <a href="/admin/cursos" class="btn-outline-action">Gerenciar Todos os Cursos →</a>
      </div>
    </div>

    <div class="courses-cards-grid">
      {activeCourses.map(course => (
        <div class="course-card">
          <div class="course-card-top">
            <span class="course-category">{course.category}</span>
            <span class="course-duration">{course.duration}</span>
          </div>
          <h3 class="course-card-title">{course.title}</h3>
          <p class="course-card-level">Nível: {course.level}</p>
          <div class="course-card-footer">
            <span class="course-enrolled">👥 {course.enrolled}</span>
            <a href={course.path} target="_blank" class="btn-table-action">
              <span>Ver Página ↗</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SEÇÃO 4: ALUNOS E INSCRIÇÕES RECENTES -->
  <section class="section-box" id="alunos">
    <div class="section-box-header">
      <div>
        <div class="section-badge section-badge-green">GESTÃO DE ALUNOS</div>
        <h2>Inscrições e Cadastros Recentes</h2>
        <p>Acompanhamento de novos alunos e solicitações de vagas nos treinamentos.</p>
      </div>
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <div class="table-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input type="text" id="filterStudentsInput" placeholder="Buscar aluno..." class="input-search-compact" />
        </div>
        <a href="/admin/alunos" class="btn-outline-action">Painel Completo de Alunos →</a>
      </div>
    </div>

    <div class="table-responsive">
      <table class="admin-table" id="studentsTable">
        <thead>
          <tr>
            <th>Nome do Aluno</th>
            <th>E-mail</th>
            <th>Curso Inscrito</th>
            <th>Data / Horário</th>
            <th>Status</th>
            <th style="text-align: right;">Ação</th>
          </tr>
        </thead>
        <tbody>
          {recentRegistrations.map(reg => (
            <tr data-name={reg.name.toLowerCase()} data-email={reg.email.toLowerCase()} data-course={reg.course.toLowerCase()}>
              <td>
                <div class="student-name-cell">
                  <div class="student-avatar-small">{reg.name.slice(0, 2).toUpperCase()}</div>
                  <strong>{reg.name}</strong>
                </div>
              </td>
              <td><code>{reg.email}</code></td>
              <td><span class="text-sub">{reg.course}</span></td>
              <td><span class="text-sub">{reg.date}</span></td>
              <td>
                <span class={`badge ${reg.status === 'Confirmado' ? 'badge-success' : reg.status === 'Em Análise' ? 'badge-warning' : 'badge-neutral'}`}>
                  {reg.status}
                </span>
              </td>
              <td style="text-align: right;">
                <button type="button" class="btn-table-action" onclick={`alert('Detalhes do aluno: ${reg.name} (${reg.email})')`}>
                  <span>Visualizar</span>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<style>
  /* ================= CABEÇALHO DO DASHBOARD ================= */
  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .header-intro h1 {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  .header-intro p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 650px;
    line-height: 1.5;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--primary-red);
    color: #FFF;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
    transition: all 0.2s ease;
  }

  .btn-primary-action:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(239, 68, 68, 0.45);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: #FFF;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.15rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary-action:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* ================= CARDS DE MÉTRICAS ================= */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .metric-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .metric-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .metric-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .metric-icon.red { background: rgba(239, 68, 68, 0.15); color: var(--primary-red); }
  .metric-icon.gold { background: rgba(245, 158, 11, 0.15); color: var(--accent-gold); }
  .metric-icon.blue { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); }
  .metric-icon.green { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); }

  .metric-info {
    display: flex;
    flex-direction: column;
  }

  .metric-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.2rem;
  }

  .metric-val {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #FFF;
    line-height: 1.2;
  }

  .metric-trend {
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }

  .text-green { color: #10B981; }
  .text-muted { color: var(--text-muted); }
  .text-sub { color: var(--text-sub); }

  /* ================= SECTION BOX ================= */
  .section-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    margin-bottom: 2.5rem;
  }

  .section-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary-red);
