---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isRequestAuthenticated } from '../../lib/admin/auth.ts';
import { fetchAllLeads, type Lead } from '../../lib/admin/leads.ts';

if (!isRequestAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

// ─── Busca leads reais da planilha Google Sheets ────────────────────────────
let studentsList: Lead[] = [];
let sheetError = false;
let sheetNotPublished = false;
let sheetEmpty = false;

try {
  studentsList = await fetchAllLeads();
  if (studentsList.length === 0) {
    sheetEmpty = true;
  }
} catch (e) {
  console.error('[alunos] Falha ao buscar leads da planilha:', e);
  sheetError = true;
}

const totalStudents  = studentsList.length;
const confirmedCount = studentsList.filter(s => s.status === 'Confirmado').length;
const pendingCount   = studentsList.filter(s => s.status === 'Lead' || s.status === 'Pendente' || s.status === 'Em Análise').length;
---

<AdminLayout title="Alunos & Inscrições | Academia do Socorrista" activeNav="alunos">
  <div class="students-view">
    <!-- CABEÇALHO -->
    <header class="page-header">
      <div class="header-intro">
        <div class="section-badge section-badge-green">GESTÃO ACADÊMICA</div>
        <h1>Inscrições, Alunos & Leads</h1>
        <p>Acompanhe matriculados, solicitações de vagas, dados de contato e status de pagamento dos treinamentos operacionais.</p>
      </div>
      <div class="header-actions">
        <a 
          href="https://docs.google.com/spreadsheets/d/1VIO65l2rGB8eUCxiCuuH0zHybFmHGaSltoAZSJLuvIo/edit" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-action-outline"
          title="Abrir a planilha original do Google Sheets"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Abrir Planilha</span>
        </a>
        <button type="button" class="btn-action-outline" onclick="window.location.reload()" title="Recarregar dados mais recentes da planilha">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 4v6h-6"></path>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span>Atualizar</span>
        </button>
        <button type="button" class="btn-action-primary" onclick="exportStudentsCSV()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Exportar CSV</span>
        </button>
      </div>
    </header>

    <!-- CARDS DE RESUMO RÁPIDO -->
    <div class="summary-cards-grid">
      <div class="summary-card">
        <div class="summary-card-header">
          <span class="summary-label">Total Cadastrado</span>
        </div>
        <div class="summary-val-row">
          <strong class="summary-val">{totalStudents}</strong>
          <span class="trend-badge trend-neutral">—</span>
        </div>
        <span class="summary-sub text-muted">Na lista de acompanhamento</span>
      </div>
      <div class="summary-card">
        <div class="summary-card-header">
          <span class="summary-label">Matrículas Confirmadas</span>
        </div>
        <div class="summary-val-row">
          <strong class="summary-val text-green">{confirmedCount}</strong>
          <span class="trend-badge trend-up">↑ Ativo</span>
        </div>
        <span class="summary-sub text-green">✓ Prontos para certificação</span>
      </div>
      <div class="summary-card">
        <div class="summary-card-header">
          <span class="summary-label">Leads / Pendentes</span>
        </div>
        <div class="summary-val-row">
          <strong class="summary-val text-gold">{pendingCount}</strong>
          <span class="trend-badge trend-pending">⏳ Aguardando</span>
        </div>
        <span class="summary-sub text-gold">Aguardando contato ou confirmação</span>
      </div>
    </div>

    <!-- AVISO: planilha não publicada -->
    {sheetNotPublished && (
      <div class="sheet-warning" id="sheetWarning">
        <div class="sheet-warning-icon">📋</div>
        <div>
          <strong>Planilha não está publicada na web</strong>
          <p>Para ver os leads reais, publique a planilha: <br/>
          Abra o Google Sheets → <strong>Arquivo → Compartilhar → Publicar na web</strong> → selecione <em>Documento inteiro</em> → clique em <strong>Publicar</strong>.</p>
        </div>
      </div>
    )}

    <!-- AVISO: erro ao buscar planilha -->
    {sheetError && (
      <div class="sheet-warning sheet-warning-error" id="sheetError">
        <div class="sheet-warning-icon">⚠️</div>
        <div>
          <strong>Não foi possível conectar à planilha</strong>
          <p>Verifique sua conexão e se a planilha está publicada na web. Os dados abaixo podem estar desatualizados.</p>
        </div>
      </div>
    )}

    <!-- BARRA DE FILTROS E BUSCA -->
    <div class="filter-bar">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input 
          type="text" 
          id="studentSearchInput" 
          class="search-input" 
          placeholder="Buscar por nome, telefone ou curso..." 
        />
      </div>

      <div class="filter-select-group">
        <select id="statusFilter" class="admin-select">
          <option value="">Todos os status</option>
          <option value="Lead">Lead</option>
          <option value="Confirmado">Confirmado</option>
          <option value="Em Análise">Em Análise</option>
          <option value="Pendente">Pendente</option>
        </select>
      </div>

      <div class="filter-select-group">
        <select id="sourceFilter" class="admin-select">
          <option value="">Todas as origens</option>
          <option value="Controle de Hemorragias">Hemorragias</option>
          <option value="Afogados / Guarda-Vidas">Afogados</option>
          <option value="Salvamento em Altura">Altura</option>
          <option value="Start Portugal">Start Portugal</option>
          <option value="Contato">Contato</option>
        </select>
      </div>
    </div>

    <!-- TABELA COMPLETA DE ALUNOS -->
    <div class="table-container">
      <table class="students-table" id="studentsTable">
        <thead>
          <tr>
            <th>Aluno & Identificador</th>
            <th>Contato</th>
            <th>Curso Solicitado</th>
            <th>Data Inscrição</th>
            <th>Status</th>
            <th style="text-align: right; width: 60px;">Ações</th>
          </tr>
        </thead>
        <tbody>
          {studentsList.map(student => (
            <tr 
              class="student-row"
              data-name={student.name.toLowerCase()} 
              data-email={student.email.toLowerCase()} 
              data-phone={student.phone.toLowerCase()} 
              data-course={student.course.toLowerCase()} 
              data-source={student.source.toLowerCase()}
              data-status={student.status}
            >
              <td>
                <div class="student-profile-cell">
                  <div class="student-avatar">{student.name ? student.name.slice(0, 2).toUpperCase() : '??'}</div>
                  <div>
                    <strong class="student-name">{student.name || '(sem nome)'}</strong>
                    <div class="student-id">{student.id}</div>
                  </div>
                </div>
              </td>
              <td>
                <div class="contact-cell">
                  {student.email && <span class="contact-email">{student.email}</span>}
                  {student.phone && (
                    <a href={`https://wa.me/55${student.phone.replace(/\D/g, '')}`} target="_blank" class="contact-phone" title="Conversar no WhatsApp">
                      💬 {student.phone}
                    </a>
                  )}
                </div>
              </td>
              <td>
                <div>
                  <strong class="course-cell-title">{student.course}</strong>
                  <div class="course-cell-mod source-tag">📥 {student.source}</div>
                </div>
              </td>
              <td>
                <span class="text-sub">{student.date || '—'}</span>
              </td>
              <td>
                <span class={`status-badge ${
                  student.status === 'Confirmado' ? 'status-confirmed' 
                  : student.status === 'Em Análise' ? 'status-analysis' 
                  : student.status === 'Lead' ? 'status-lead'
                  : student.status === 'Pendente' ? 'status-pending'
                  : 'status-cancelled'
                }`}>
                  <span class="status-dot"></span>
                  {student.status}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="actions-dropdown">
                  <button type="button" class="actions-dropdown-trigger" data-tooltip="Ações">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
                    </svg>
                  </button>
                  <div class="actions-dropdown-menu">
                    <button 
                      type="button" 
                      class="dropdown-item"
                      onclick={`showStudentDetails(${JSON.stringify(student).replace(/"/g, '&quot;')})`}
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      Ver ficha completa
                    </button>
                    {student.phone && (
                      <a 
                        href={`https://wa.me/55${student.phone.replace(/\D/g, '')}?text=Ol%C3%A1+${encodeURIComponent(student.name)}%2C+tudo+bem%3F+Aqui+%C3%A9+a+Academia+do+Socorrista.+Recebemos+seu+interesse+no+curso+${encodeURIComponent(student.course)}.`} 
                        target="_blank" 
                        class="dropdown-item dropdown-item-green"
                      >
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                        WhatsApp
                      </a>
                    )}
                    {student.email && (
                      <a href={`mailto:${student.email}`} class="dropdown-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Enviar e-mail
                      </a>
                    )}
                    <div class="dropdown-divider"></div>
                    <button type="button" class="dropdown-item dropdown-item-green" onclick={`alert('Matrícula de ${student.name} confirmada.')`}>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      Confirmar matrícula
                    </button>
                  </div>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- EMPTY STATE -->
      <div id="noStudentsFound" class="empty-state" style="display: none;">
        <div class="empty-state-icon">👥</div>
        <h3>Nenhum registro encontrado</h3>
        <p>Nenhum aluno ou lead corresponde aos critérios de pesquisa digitados.</p>
      </div>

      <!-- Skeleton Loader (carregamento) -->
      <div id="alunosSkeletonLoader" style="display: none;">
        <div class="skeleton-row"><div class="skeleton skeleton-avatar"></div><div class="skeleton-row-content"><div class="skeleton skeleton-text"></div><div class="skeleton skeleton-text-sm"></div></div><div class="skeleton skeleton-badge"></div></div>
        <div class="skeleton-row"><div class="skeleton skeleton-avatar"></div><div class="skeleton-row-content"><div class="skeleton skeleton-text"></div><div class="skeleton skeleton-text-sm"></div></div><div class="skeleton skeleton-badge"></div></div>
        <div class="skeleton-row"><div class="skeleton skeleton-avatar"></div><div class="skeleton-row-content"><div class="skeleton skeleton-text"></div><div class="skeleton skeleton-text-sm"></div></div><div class="skeleton skeleton-badge"></div></div>
        <div class="skeleton-row"><div class="skeleton skeleton-avatar"></div><div class="skeleton-row-content"><div class="skeleton skeleton-text"></div><div class="skeleton skeleton-text-sm"></div></div><div class="skeleton skeleton-badge"></div></div>
        <div class="skeleton-row"><div class="skeleton skeleton-avatar"></div><div class="skeleton-row-content"><div class="skeleton skeleton-text"></div><div class="skeleton skeleton-text-sm"></div></div><div class="skeleton skeleton-badge"></div></div>
      </div>
    </div>
  </div>

  <!-- MODAL DE DETALHES DO ALUNO -->
  <div id="studentModal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <span class="section-badge section-badge-green" id="modalStudentId">ALU-0000</span>
          <h3 id="modalStudentName" style="margin-top: 0.25rem;">Nome do Aluno</h3>
        </div>
        <button type="button" class="modal-close" onclick="closeStudentModal()">&times;</button>
      </div>

      <div class="modal-body">
        <div class="details-grid">
          <div class="detail-item">
            <span>E-mail</span>
            <strong id="modalStudentEmail"></strong>
          </div>
          <div class="detail-item">
            <span>Telefone / WhatsApp</span>
            <strong id="modalStudentPhone"></strong>
          </div>
          <div class="detail-item">
            <span>Curso Escolhido</span>
            <strong id="modalStudentCourse"></strong>
          </div>
          <div class="detail-item">
            <span>Modalidade</span>
            <strong id="modalStudentModality"></strong>
          </div>
          <div class="detail-item">
            <span>Forma de Pagamento</span>
            <strong id="modalStudentPayment"></strong>
          </div>
          <div class="detail-item">
            <span>Status da Matrícula</span>
            <strong id="modalStudentStatus"></strong>
          </div>
        </div>

        <div class="notes-box">
          <span class="notes-label">Observações e Histórico:</span>
          <p id="modalStudentNotes" class="notes-text"></p>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-action-secondary" onclick="closeStudentModal()">Fechar</button>
        <button type="button" class="btn-action-primary" onclick="alert('Status atualizado com sucesso no banco de dados local.')">
          Confirmar Vaga do Aluno
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .students-view {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .header-intro h1 {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .header-intro p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 650px;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.8px;
    margin-bottom: 0.35rem;
  }

  .section-badge-green {
    background: rgba(16, 185, 129, 0.12);
    color: var(--accent-green);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-action-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-red);
    color: #FFF;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.3);
    transition: all 0.2s ease;
  }

  .btn-action-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .btn-action-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 0.65rem 1.15rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-action-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* SUMMARY CARDS */
  .summary-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .summary-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .summary-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 6px 20px rgba(0,0,0,0.2);
  }

  .summary-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .summary-val-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .trend-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
    line-height: 1.3;
  }

  .trend-up {
    background: rgba(52, 211, 153, 0.15);
    color: #34D399;
    border: 1px solid rgba(52, 211, 153, 0.25);
  }

  .trend-neutral {
    background: rgba(148, 163, 184, 0.10);
    color: var(--text-muted);
    border: 1px solid rgba(148, 163, 184, 0.18);
  }

  .trend-pending {
    background: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.22);
  }

  .summary-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .summary-val {
    font-size: 1.7rem;
    font-weight: 700;
    color: #FFF;
  }

  .summary-sub {
    font-size: 0.78rem;
  }

  .text-green { color: #10B981; }
  .text-gold { color: #F59E0B; }
  .text-muted { color: var(--text-muted); }
  .text-sub { color: var(--text-sub); }

  /* FILTROS */
  .filter-bar {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    flex: 1;
    min-width: 280px;
  }

  .search-input {
    background: transparent;
    border: none;
    outline: none;
    color: #FFF;
    font-size: 0.9rem;
    width: 100%;
  }

  .admin-select {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
    color: #FFF;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-size: 0.85rem;
    outline: none;
    cursor: pointer;
  }

  /* TABELA */
  .table-container {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .table-container .students-table {
    min-width: 850px;
  }

  @media (max-width: 900px) {
    .table-container {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  .students-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .students-table th {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.9rem 1.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-sub);
    border-bottom: 1px solid var(--border);
  }

  .students-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .students-table tr:hover td {
    background: rgba(255, 255, 255, 0.015);
  }

  .student-profile-cell {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .student-avatar {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #EF4444, #B91C1C);
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .student-name {
    display: block;
    color: #FFF;
  }

  .student-id {
    font-size: 0.72rem;
    color: var(--text-sub);
    font-family: monospace;
  }

  .contact-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-email {
    font-size: 0.85rem;
    color: var(--text-main);
  }

  .contact-phone {
    font-size: 0.78rem;
    color: #10B981;
    text-decoration: none;
    font-weight: 500;
  }

