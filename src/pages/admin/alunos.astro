<script is:inline>
  // Filtros interativos de busca, status e origem
  const searchInput   = document.getElementById('studentSearchInput');
  const statusFilter  = document.getElementById('statusFilter');
  const sourceFilter  = document.getElementById('sourceFilter');
  const rows          = document.querySelectorAll('.student-row');
  const noStudentsFound = document.getElementById('noStudentsFound');

  function applyFilters() {
    const query          = searchInput   ? searchInput.value.toLowerCase().trim() : '';
    const selectedStatus = statusFilter  ? statusFilter.value.toLowerCase()  : '';
    const selectedSource = sourceFilter  ? sourceFilter.value.toLowerCase()  : '';
    let visibleCount = 0;

    rows.forEach(row => {
      const name   = row.getAttribute('data-name')   || '';
      const email  = row.getAttribute('data-email')  || '';
      const phone  = row.getAttribute('data-phone')  || '';
      const course = row.getAttribute('data-course') || '';
      const status = (row.getAttribute('data-status') || '').toLowerCase();
      const source = (row.getAttribute('data-source') || '').toLowerCase();

      const matchesSearch  = !query          || name.includes(query) || email.includes(query) || phone.includes(query) || course.includes(query);
      const matchesStatus  = !selectedStatus || status.includes(selectedStatus);
      const matchesSource  = !selectedSource || source.includes(selectedSource);

      if (matchesSearch && matchesStatus && matchesSource) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noStudentsFound) {
      noStudentsFound.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input',  applyFilters);
  statusFilter?.addEventListener('change', applyFilters);
  sourceFilter?.addEventListener('change', applyFilters);

  // Modal de Detalhes
  const studentModal = document.getElementById('studentModal');
  const modalStudentId = document.getElementById('modalStudentId');
  const modalStudentName = document.getElementById('modalStudentName');
  const modalStudentEmail = document.getElementById('modalStudentEmail');
  const modalStudentPhone = document.getElementById('modalStudentPhone');
  const modalStudentCourse = document.getElementById('modalStudentCourse');
  const modalStudentModality = document.getElementById('modalStudentModality');
  const modalStudentPayment = document.getElementById('modalStudentPayment');
  const modalStudentStatus = document.getElementById('modalStudentStatus');
  const modalStudentNotes = document.getElementById('modalStudentNotes');

  window.showStudentDetails = function(student) {
    if (!studentModal) return;
    if (modalStudentId)   modalStudentId.textContent   = student.id;
    if (modalStudentName) modalStudentName.textContent = student.name;
    if (modalStudentEmail) modalStudentEmail.textContent = student.email || '—';
    if (modalStudentPhone) modalStudentPhone.textContent = student.phone || '—';
    if (modalStudentCourse) modalStudentCourse.textContent = student.course;
    if (modalStudentModality) modalStudentModality.textContent = student.source || '—';
    if (modalStudentPayment) modalStudentPayment.textContent = student.date || '—';
    if (modalStudentStatus) modalStudentStatus.textContent = student.status;
    if (modalStudentNotes) modalStudentNotes.textContent = student.message || 'Sem mensagem registrada.';
    studentModal.style.display = 'flex';
  };

  window.closeStudentModal = function() {
    if (studentModal) studentModal.style.display = 'none';
  };

  window.openNewStudentModal = function() {
    alert('Formulário de cadastro rápido de novo aluno: você pode registrar um aluno diretamente por aqui.');
  };

  window.exportStudentsCSV = function() {
    const allRows = document.querySelectorAll('.student-row');
    let csv = 'ID,Nome,Email,Telefone,Curso,Origem,Data,Status\n';
    allRows.forEach(row => {
      const cells = row.querySelectorAll('td');
      if (cells.length < 5) return;
      const id     = row.querySelector('.student-id')?.textContent?.trim()  ?? '';
      const name   = row.querySelector('.student-name')?.textContent?.trim() ?? '';
      const email  = row.querySelector('.contact-email')?.textContent?.trim() ?? '';
      const phone  = row.querySelector('.contact-phone')?.textContent?.trim().replace('💬 ','') ?? '';
      const course = row.querySelector('.course-cell-title')?.textContent?.trim() ?? '';
      const source = row.getAttribute('data-source') ?? '';
      const date   = cells[3]?.textContent?.trim() ?? '';
      const status = row.getAttribute('data-status') ?? '';
      csv += `"${id}","${name}","${email}","${phone}","${course}","${source}","${date}","${status}"\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', 'leads-academia-do-socorrista.csv');
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };
</script>
