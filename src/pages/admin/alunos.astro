---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { isRequestAuthenticated } from '../../lib/admin/auth.ts';

if (!isRequestAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

// ─── Busca leads reais da planilha Google Sheets ────────────────────────────
interface Lead {
  id: string;
  name: string;
  phone: string;
  email: string;
  course: string;
  source: string;
  date: string;
  message: string;
  status: string;
}

let studentsList: Lead[] = [];
let sheetError = false;
let sheetNotPublished = false;

try {
  const baseUrl = Astro.url.origin;
  const res = await fetch(`${baseUrl}/api/admin/leads`, {
    headers: { cookie: Astro.request.headers.get('cookie') ?? '' },
  });

  if (res.ok) {
    const data = await res.json();
    if (data.ok && Array.isArray(data.leads) && data.leads.length > 0) {
      studentsList = data.leads;
    } else if (data.ok && data.leads.length === 0) {
      sheetNotPublished = true;
    } else {
      sheetError = true;
    }
  } else {
    sheetError = true;
  }
} catch (e) {
  console.error('[alunos] Falha ao buscar leads:', e);
  sheetError = true;
}

const totalStudents  = studentsList.length;
const confirmedCount = studentsList.filter(s => s.status === 'Confirmado').length;
const pendingCount   = studentsList.filter(s => s.status === 'Lead' || s.status === 'Pendente' || s.status === 'Em Análise').length;
---

<AdminLayout title="Alunos & Inscrições | Academia do Socorrista" activeNav="alunos">
  <div class="students-view">
    <!-- CABEÇALHO -->
    <header class="page-header">
      <div class="header-intro">
        <div class="section-badge section-badge-green">GESTÃO ACADÊMICA</div>
        <h1>Inscrições, Alunos & Leads</h1>
        <p>Acompanhe matriculados, solicitações de vagas, dados de contato e status de pagamento dos treinamentos operacionais.</p>
      </div>
      <div class="header-actions">
        <button type="button" class="btn-action-secondary" onclick="exportStudentsCSV()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Exportar CSV</span>
        </button>
        <button type="button" class="btn-action-primary" onclick="openNewStudentModal()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span>Registrar Inscrição Manual</span>
        </button>
      </div>
    </header>

    <!-- CARDS DE RESUMO RÁPIDO -->
    <div class="summary-cards-grid">
      <div class="summary-card">
        <span class="summary-label">Total Cadastrado</span>
        <strong class="summary-val">{totalStudents}</strong>
        <span class="summary-sub text-muted">Na lista de acompanhamento</span>
      </div>
      <div class="summary-card">
        <span class="summary-label">Matrículas Confirmadas</span>
        <strong class="summary-val text-green">{confirmedCount}</strong>
        <span class="summary-sub text-green">✓ Prontos para certificação</span>
      </div>
      <div class="summary-card">
        <span class="summary-label">Leads / Pendentes</span>
        <strong class="summary-val text-gold">{pendingCount}</strong>
        <span class="summary-sub text-gold">⏳ Aguardando contato ou confirmação</span>
      </div>
    </div>

    <!-- AVISO: planilha não publicada -->
    {sheetNotPublished && (
      <div class="sheet-warning" id="sheetWarning">
        <div class="sheet-warning-icon">📋</div>
        <div>
          <strong>Planilha não está publicada na web</strong>
          <p>Para ver os leads reais, publique a planilha: <br/>
          Abra o Google Sheets → <strong>Arquivo → Compartilhar → Publicar na web</strong> → selecione <em>Documento inteiro</em> → clique em <strong>Publicar</strong>.</p>
        </div>
      </div>
    )}

    <!-- AVISO: erro ao buscar planilha -->
    {sheetError && (
      <div class="sheet-warning sheet-warning-error" id="sheetError">
        <div class="sheet-warning-icon">⚠️</div>
        <div>
          <strong>Não foi possível conectar à planilha</strong>
          <p>Verifique sua conexão e se a planilha está publicada na web. Os dados abaixo podem estar desatualizados.</p>
        </div>
      </div>
    )}

    <!-- BARRA DE FILTROS E BUSCA -->
    <div class="filter-bar">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input 
          type="text" 
          id="studentSearchInput" 
          class="search-input" 
          placeholder="Buscar por nome, telefone ou curso..." 
        />
      </div>

      <div class="filter-select-group">
        <select id="statusFilter" class="admin-select">
          <option value="">Todos os status</option>
          <option value="Lead">Lead</option>
          <option value="Confirmado">Confirmado</option>
          <option value="Em Análise">Em Análise</option>
          <option value="Pendente">Pendente</option>
        </select>
      </div>

      <div class="filter-select-group">
        <select id="sourceFilter" class="admin-select">
          <option value="">Todas as origens</option>
          <option value="Controle de Hemorragias">Hemorragias</option>
          <option value="Afogados / Guarda-Vidas">Afogados</option>
          <option value="Salvamento em Altura">Altura</option>
          <option value="Start Portugal">Start Portugal</option>
          <option value="Contato">Contato</option>
        </select>
      </div>
    </div>

    <!-- TABELA COMPLETA DE ALUNOS -->
    <div class="table-container">
      <table class="students-table" id="studentsTable">
        <thead>
          <tr>
            <th>Aluno & Identificador</th>
            <th>Contato</th>
            <th>Curso Solicitado</th>
            <th>Data Inscrição</th>
            <th>Status</th>
            <th style="text-align: right;">Ações Rápidas</th>
          </tr>
        </thead>
        <tbody>
          {studentsList.map(student => (
            <tr 
              class="student-row"
              data-name={student.name.toLowerCase()} 
              data-email={student.email.toLowerCase()} 
              data-phone={student.phone.toLowerCase()} 
              data-course={student.course.toLowerCase()} 
              data-source={student.source.toLowerCase()}
              data-status={student.status}
            >
              <td>
                <div class="student-profile-cell">
                  <div class="student-avatar">{student.name ? student.name.slice(0, 2).toUpperCase() : '??'}</div>
                  <div>
                    <strong class="student-name">{student.name || '(sem nome)'}</strong>
                    <div class="student-id">{student.id}</div>
                  </div>
                </div>
              </td>
              <td>
                <div class="contact-cell">
                  {student.email && <span class="contact-email">{student.email}</span>}
                  {student.phone && (
                    <a href={`https://wa.me/55${student.phone.replace(/\D/g, '')}`} target="_blank" class="contact-phone" title="Conversar no WhatsApp">
                      💬 {student.phone}
                    </a>
                  )}
                </div>
              </td>
              <td>
                <div>
                  <strong class="course-cell-title">{student.course}</strong>
                  <div class="course-cell-mod source-tag">📥 {student.source}</div>
                </div>
              </td>
              <td>
                <span class="text-sub">{student.date || '—'}</span>
              </td>
              <td>
                <span class={`badge ${
                  student.status === 'Confirmado' ? 'badge-success' 
                  : student.status === 'Em Análise' ? 'badge-warning' 
                  : student.status === 'Lead' ? 'badge-lead'
                  : 'badge-danger'
                }`}>
                  {student.status}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="row-actions">
                  <button 
                    type="button" 
                    class="action-btn"
                    onclick={`showStudentDetails(${JSON.stringify(student).replace(/"/g, '&quot;')})`}
                    title="Ver ficha completa"
                  >
                    Ficha
                  </button>
                  {student.phone && (
                    <a 
                      href={`https://wa.me/55${student.phone.replace(/\D/g, '')}?text=Ol%C3%A1+${encodeURIComponent(student.name)}%2C+tudo+bem%3F+Aqui+%C3%A9+a+Academia+do+Socorrista.+Recebemos+seu+interesse+no+curso+${encodeURIComponent(student.course)}.`} 
                      target="_blank" 
                      class="action-btn action-btn-green"
                      title="Enviar mensagem rápida no WhatsApp"
                    >
                      WhatsApp
                    </a>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- EMPTY STATE -->
      <div id="noStudentsFound" class="empty-state" style="display: none;">
        <div class="empty-state-icon">👥</div>
        <h3>Nenhum registro encontrado</h3>
        <p>Nenhum aluno ou lead corresponde aos critérios de pesquisa digitados.</p>
      </div>
    </div>
  </div>

  <!-- MODAL DE DETALHES DO ALUNO -->
  <div id="studentModal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div>
          <span class="section-badge section-badge-green" id="modalStudentId">ALU-0000</span>
          <h3 id="modalStudentName" style="margin-top: 0.25rem;">Nome do Aluno</h3>
        </div>
        <button type="button" class="modal-close" onclick="closeStudentModal()">&times;</button>
      </div>

      <div class="modal-body">
        <div class="details-grid">
          <div class="detail-item">
            <span>E-mail</span>
            <strong id="modalStudentEmail"></strong>
          </div>
          <div class="detail-item">
            <span>Telefone / WhatsApp</span>
            <strong id="modalStudentPhone"></strong>
          </div>
          <div class="detail-item">
            <span>Curso Escolhido</span>
            <strong id="modalStudentCourse"></strong>
          </div>
          <div class="detail-item">
            <span>Modalidade</span>
            <strong id="modalStudentModality"></strong>
          </div>
          <div class="detail-item">
            <span>Forma de Pagamento</span>
            <strong id="modalStudentPayment"></strong>
          </div>
          <div class="detail-item">
            <span>Status da Matrícula</span>
            <strong id="modalStudentStatus"></strong>
          </div>
        </div>

        <div class="notes-box">
          <span class="notes-label">Observações e Histórico:</span>
          <p id="modalStudentNotes" class="notes-text"></p>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-action-secondary" onclick="closeStudentModal()">Fechar</button>
        <button type="button" class="btn-action-primary" onclick="alert('Status atualizado com sucesso no banco de dados local.')">
          Confirmar Vaga do Aluno
        </button>
      </div>
    </div>
  </div>
</AdminLayout>

