---
export const prerender = false;

import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { isRequestAuthenticated } from '../../../lib/admin/auth.ts';
import { listLocalArticles } from '../../../lib/admin/articles.ts';
import { getGitHubConfig } from '../../../lib/admin/github.ts';

if (!isRequestAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/login');
}

const articles = await listLocalArticles();
const githubConfig = getGitHubConfig();
const hasGitHub = Boolean(githubConfig.token);
---

<AdminLayout title="Gerenciamento de Artigos | Academia do Socorrista" activeNav="artigos">
  <div class="articles-view">
    <!-- CABEÇALHO DA PÁGINA -->
    <header class="page-header">
      <div class="header-intro">
        <div class="section-badge">BLOG & EDUCAÇÃO</div>
        <h1>Gerenciamento de Artigos</h1>
        <p>Crie, edite e revise artigos científicos e informativos sobre APH, Salvamento e Primeiros Socorros.</p>
      </div>
      <div class="header-actions">
        <button id="btn-open-pr-modal" class="btn-action-secondary" title="Sincronizar branch de rascunhos com a principal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/><polyline points="16 16 12 12 8 16"/>
          </svg>
          <span>Solicitar Publicação (PR)</span>
        </button>
        <a href="/admin/artigos/novo" class="btn-action-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span>Novo Artigo</span>
        </a>
      </div>
    </header>

    <!-- BARRA DE PESQUISA E FILTROS -->
    <div class="filter-bar">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input 
          type="text" 
          id="search-input" 
          class="search-input" 
          placeholder="Pesquisar por título ou slug..." 
        />
      </div>
      <div class="stats-count">
        Total de <strong id="visible-count">{articles.length}</strong> artigos no acervo
      </div>
    </div>

    <!-- TABELA DE ARTIGOS -->
    <div class="table-container">
      <table class="articles-table">
        <thead>
          <tr>
            <th>Artigo / Publicação</th>
            <th>Data de Publicação</th>
            <th>Origem</th>
            <th style="text-align: right;">Ações Rápidas</th>
          </tr>
        </thead>
        <tbody id="articles-tbody">
          {articles.map((art) => (
            <tr class="article-row" data-title={art.meta.title.toLowerCase()} data-slug={art.slug.toLowerCase()}>
              <td>
                <div class="article-info">
                  {art.meta.heroImage ? (
                    <img src={art.meta.heroImage} alt="" class="article-thumb" onerror="this.style.display='none'" />
                  ) : (
                    <div class="article-thumb-placeholder">📄</div>
                  )}
                  <div>
                    <div class="article-title">{art.meta.title}</div>
                    <div class="article-slug">/blog/{art.slug}</div>
                  </div>
                </div>
              </td>
              <td style="color: var(--text-muted); white-space: nowrap;">
                {art.meta.pubDate ? new Date(art.meta.pubDate).toLocaleDateString('pt-BR') : 'Data não informada'}
              </td>
              <td>
                <span class="badge-status">Repositório</span>
              </td>
              <td style="text-align: right;">
                <div class="row-actions">
                  <a href={`/admin/artigos/preview?slug=${art.slug}`} class="action-btn" title="Prévia administrativa">
                    Prévia
                  </a>
                  <a href={`/admin/artigos/editar?slug=${art.slug}`} class="action-btn action-btn-primary" title="Editar artigo">
                    Editar
                  </a>
                  <a href={`/blog/${art.slug}`} target="_blank" class="action-btn action-btn-icon" title="Ver versão pública">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- EMPTY STATE -->
      <div id="no-results" class="empty-state" style="display: none;">
        <div class="empty-state-icon">🔍</div>
        <h3>Nenhum artigo encontrado</h3>
        <p>Não encontramos nenhum artigo correspondente à sua busca. Tente buscar por outros termos ou crie um novo artigo.</p>
      </div>
    </div>
  </div>

  <!-- MODAL DE PULL REQUEST -->
  <div id="pr-modal" class="modal-overlay">
    <div class="modal-card">
      <div class="modal-header">
        <div class="section-badge section-badge-blue">SINCRONIZAÇÃO GITHUB</div>
        <h3>Publicar Alterações (Pull Request)</h3>
      </div>
      <p>
        Este procedimento cria ou atualiza um <strong>Pull Request</strong> da branch de rascunhos (<code>cms-drafts</code>) para a branch oficial (<code>main</code>), permitindo que você revise todas as alterações antes de colocá-las no ar.
      </p>
      <div id="pr-status-msg"></div>
      <div class="modal-actions">
        <button id="btn-cancel-pr" class="btn-action-secondary">Cancelar</button>
        <button id="btn-confirm-pr" class="btn-action-primary">Criar Pull Request</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .articles-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary-red);
    background: rgba(239, 68, 68, 0.12);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.8px;
    margin-bottom: 0.35rem;
  }

  .section-badge-blue {
    color: var(--accent-blue);
    background: rgba(59, 130, 246, 0.12);
  }

  .header-intro h1 {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .header-intro p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 600px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-action-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--primary-red);
    color: #FFF;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.3);
    transition: all 0.2s ease;
  }

  .btn-action-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-1px);
  }

  .btn-action-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 0.65rem 1.15rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-action-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* BARRA DE FILTRO */
  .filter-bar {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 1rem;
    color: var(--text-muted);
    flex: 1;
    min-width: 260px;
    max-width: 500px;
  }

  .search-input {
    background: transparent;
    border: none;
    outline: none;
    color: #FFF;
    font-size: 0.9rem;
    width: 100%;
  }

  .search-input::placeholder {
    color: var(--text-sub);
  }

  .stats-count {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* TABELA */
  .table-container {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .articles-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }

  .articles-table th {
    background: rgba(0, 0, 0, 0.2);
    padding: 0.9rem 1.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-sub);
    border-bottom: 1px solid var(--border);
  }

  .articles-table td {
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .articles-table tr:hover td {
    background: rgba(255, 255, 255, 0.015);
  }

  .article-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .article-thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    object-fit: cover;
    background: #1f2937;
    flex-shrink: 0;
  }

  .article-thumb-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .article-title {
    font-weight: 600;
    color: #FFF;
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .article-slug {
    font-size: 0.78rem;
    color: var(--text-sub);
    font-family: monospace;
  }

  .badge-status {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
  }

  .row-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .action-btn {
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-main);
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #FFF;
  }

  .action-btn-primary {
    background: rgba(239, 68, 68, 0.15);
    color: #F87171;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .action-btn-primary:hover {
    background: var(--primary-red);
    color: #FFF;
  }

  .action-btn-icon {
    padding: 0.45rem 0.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* EMPTY STATE */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-state-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.6;
  }

  .empty-state h3 {
    font-size: 1.2rem;
    color: #FFF;
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 450px;
    margin: 0 auto;
  }

  /* MODAL */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 10000;
    padding: 1.5rem;
  }

  .modal-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    max-width: 520px;
    width: 100%;
    padding: 2rem;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.6);
  }

  .modal-header {
    margin-bottom: 1rem;
  }

  .modal-card h3 {
    font-size: 1.25rem;
    color: #FFF;
  }

  .modal-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }
</style>

<script>
  // Filtro de Busca em Tempo Real
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const rows = document.querySelectorAll<HTMLTableRowElement>('.article-row');
  const noResults = document.getElementById('no-results');
  const visibleCount = document.getElementById('visible-count');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let count = 0;

    rows.forEach((row) => {
      const title = row.getAttribute('data-title') || '';
      const slug = row.getAttribute('data-slug') || '';
      if (title.includes(query) || slug.includes(query)) {
        row.style.display = '';
        count++;
      } else {
        row.style.display = 'none';
      }
    });

    if (visibleCount) visibleCount.textContent = count.toString();
    if (noResults) noResults.style.display = count === 0 ? 'block' : 'none';
  });

  // Modal de Pull Request
  const prModal = document.getElementById('pr-modal');
  const btnOpenPrModal = document.getElementById('btn-open-pr-modal');
  const btnCancelPr = document.getElementById('btn-cancel-pr');
  const btnConfirmPr = document.getElementById('btn-confirm-pr') as HTMLButtonElement;
  const prStatusMsg = document.getElementById('pr-status-msg');

  btnOpenPrModal?.addEventListener('click', () => {
    if (prModal) prModal.style.display = 'flex';
    if (prStatusMsg) prStatusMsg.innerHTML = '';
  });

  btnCancelPr?.addEventListener('click', () => {
    if (prModal) prModal.style.display = 'none';
  });

  btnConfirmPr?.addEventListener('click', async () => {
    if (!btnConfirmPr || !prStatusMsg) return;
    btnConfirmPr.disabled = true;
    btnConfirmPr.textContent = 'Processando...';
    prStatusMsg.innerHTML = '<span style="color: #60a5fa;">Conectando à API do GitHub...</span>';

    try {
      const res = await fetch('/api/admin/publish-pr', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      });

      const data = await res.json();

      if (res.ok && data.ok) {
        prStatusMsg.innerHTML = `
          <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #6ee7b7; padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem;">
            ${data.message}
            ${data.prUrl ? `<br/><a href="${data.prUrl}" target="_blank" style="color: white; font-weight: bold; text-decoration: underline; margin-top: 0.5rem; display: inline-block;">Visualizar Pull Request no GitHub ↗</a>` : ''}
          </div>
        `;
        btnConfirmPr.textContent = 'Concluído';
      } else {
        prStatusMsg.innerHTML = `
          <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; color: #fca5a5; padding: 0.75rem; border-radius: 6px; margin-bottom: 1rem;">
            ${data.message || data.error || 'Falha ao solicitar publicação.'}
          </div>
        `;
        btnConfirmPr.disabled = false;
        btnConfirmPr.textContent = 'Tentar Novamente';
      }
    } catch (err: any) {
      prStatusMsg.innerHTML = `<span style="color: #f87171;">Erro: ${err.message}</span>`;
      btnConfirmPr.disabled = false;
      btnConfirmPr.textContent = 'Tentar Novamente';
    }
  });
</script>
