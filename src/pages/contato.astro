---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contato | Fale com a Academia do Socorrista";
const description = "Entre em contato conosco para tirar dúvidas sobre treinamentos, inscrições e certificações.";

const contactItems = [
  {
    icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="#25D366" style="width: 32px; height: 32px;"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157.1zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>',
    title: '',
    value: 'WhatsApp',
    link: 'https://bitlybr.net/whatsapp_AS',
    subtitle: 'FALAR COM ESPECIALISTAS',
    target: '_blank'
  },
  {
    icon: '📧',
    title: 'E-mail do Suporte',
    value: 'contato@academiadosocorrista.com.br',
    link: 'mailto:contato@academiadosocorrista.com.br',
    subtitle: 'Retorno em até 24 horas úteis',
    target: '_self'
  },
  {
    icon: '📍',
    title: 'Nossa Base',
    value: 'Itajaí - Centro / SC',
    link: '#mapa',
    subtitle: 'Atendendo todo o Brasil',
    target: '_self'
  }
];
---

<Layout title={title} description={description}>
	<Header />
	<main>
		<section class="page-hero">
			<div class="container animate-fade">
				<span class="section-badge">Próximo Nível</span>
				<h1>Fale <span class="text-gradient">Conosco</span></h1>
				<p>Pronto para se capacitar? Preencha o formulário ou chame no WhatsApp para tirar suas dúvidas com a nossa equipe de suporte.</p>
			</div>
		</section>

		<section class="contact-section">
			<div class="container contact-grid">
				<div class="contact-methods animate-fade">
					{contactItems.map(item => (
						<a href={item.link} class="glass-card contact-item" target={item.target} rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}>
							<div class="item-icon" set:html={item.icon}></div>
							<div class="item-text">
								{item.title && <h3>{item.title}</h3>}
								<span class="item-value">{item.value}</span>
								<span class="item-subtitle">{item.subtitle}</span>
							</div>
						</a>
					))}
				</div>

				<div class="contact-form-area glass-card animate-fade" style="animation-delay: 0.2s;">
					<h2>Envie sua Mensagem</h2>
					<div id="form-success" class="form-feedback success" style="display:none;">✅ Mensagem enviada com sucesso! Entraremos em contato em breve.</div>
					<div id="form-error" class="form-feedback error" style="display:none;">❌ Ocorreu um erro. Tente novamente ou fale pelo WhatsApp.</div>
					<form class="contact-form" id="contactForm">
						<div class="form-row">
							<div class="form-group">
								<label for="name">Nome Completo</label>
								<input type="text" id="name" placeholder="Como podemos te chamar?" required />
							</div>
							<div class="form-group">
								<label for="phone">Telefone / WhatsApp</label>
								<input type="tel" id="phone" placeholder="(XX) XXXXX-XXXX" required />
							</div>
						</div>
						
						<div class="form-group">
							<label for="message">Sua Mensagem</label>
							<textarea id="message" rows="5" placeholder="Descreva brevemente sua necessidade..."></textarea>
						</div>

						<button type="submit" id="submitBtn" class="btn btn-primary w-full">Enviar Mensagem agora</button>
					</form>

					<script is:inline>
						document.getElementById('contactForm').addEventListener('submit', async function(e) {
							e.preventDefault();
							const btn = document.getElementById('submitBtn');
							const successEl = document.getElementById('form-success');
							const errorEl = document.getElementById('form-error');

							btn.disabled = true;
							btn.textContent = 'Enviando...';

							const payload = {
								nome: document.getElementById('name').value,
								telefone: document.getElementById('phone').value,
								mensagem: document.getElementById('message').value
							};

							try {
								await fetch('https://script.google.com/macros/s/AKfycbxCT_SvVMlyGME9xLaeA1O9sLz4Nl7jFWPG39bNEH4LLckK7dxeBnsDi1N_eEsQVqHM/exec', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify(payload),
									mode: 'no-cors'
								});
								successEl.style.display = 'block';
								errorEl.style.display = 'none';
								document.getElementById('contactForm').reset();
							} catch (err) {
								errorEl.style.display = 'block';
								successEl.style.display = 'none';
							} finally {
								btn.disabled = false;
								btn.textContent = 'Enviar Mensagem agora';
							}
						});
					</script>
				</div>
			</div>
		</section>

		<section class="map-section animate-fade" id="mapa">
			<div class="container">
				<div class="map-container glass-card">
					<div class="map-placeholder">
						<h3 class="hero-like-title"><span class="text-gradient">Reaja Melhor em Situações de Emergência</span></h3>
						<p>Mais do que aprender técnicas, você aprende a fazer diferença.<br>Conheça nossos cursos e evolua com quem leva emergências a sério.</p>
						<a href="/cursos" class="coverage-badge">Conheça Nossos Cursos</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.page-hero {
		padding: 200px 0 100px;
		background: var(--dark-surface);
		text-align: center;
		border-bottom: 1px solid var(--glass-border);
	}

	.page-hero h1 {
		font-size: 4rem;
		margin-bottom: 20px;
	}

	.page-hero p {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.contact-section {
		padding: 120px 0;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 0.8fr 1.2fr;
		gap: 60px;
		align-items: flex-start;
	}

	.contact-methods {
		display: grid;
		gap: 20px;
	}

	.contact-item {
		display: flex;
		padding: 30px;
		gap: 25px;
		text-decoration: none;
		align-items: center;
		transition: var(--transition);
	}

	.contact-item:hover {
		border-color: var(--primary);
		transform: scale(1.02);
	}

	.item-icon {
		font-size: 2rem;
		background: rgba(255, 215, 0, 0.1);
		width: 60px;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 15px;
		flex-shrink: 0;
	}

	.item-text h3 {
		font-size: 1rem;
		color: var(--text-muted);
		margin-bottom: 5px;
		font-weight: 500;
	}

	.item-value {
		display: block;
		font-size: 1.3rem;
		font-weight: 800;
		color: white;
		line-height: 1.2;
		margin-bottom: 4px;
	}

	.item-subtitle {
		font-size: 0.85rem;
		color: var(--primary);
		font-weight: 700;
		text-transform: uppercase;
	}

	.contact-form-area {
		padding: 60px;
	}

	.contact-form-area h2 {
		font-size: 2.2rem;
		margin-bottom: 40px;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 25px;
	}

	.form-group {
		margin-bottom: 25px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.form-group label {
		font-size: 0.95rem;
		font-weight: 700;
		color: white;
	}

	.form-group input, .form-group select, .form-group textarea {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid var(--glass-border);
		padding: 15px 20px;
		border-radius: 12px;
		color: white;
		font-size: 1rem;
		width: 100%;
	}

	.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
		outline: none;
		border-color: var(--primary);
	}

	.map-section {
		padding-bottom: 150px;
	}

	.map-container {
		min-height: 400px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #121212 0%, #0A0A0A 100%);
		text-align: center;
		padding: 60px 40px;
	}

	.hero-like-title {
		font-size: 4.5rem;
		line-height: 1.1;
		margin-bottom: 25px;
	}

	@media (max-width: 1200px) {
		.hero-like-title { font-size: 3.5rem; }
	}

	.coverage-badge {
		display: inline-block;
		margin-top: 25px;
		background: var(--primary);
		color: var(--dark);
		padding: 8px 25px;
		border-radius: 100px;
		font-weight: 800;
		font-size: 0.85rem;
		text-decoration: none;
		transition: transform 0.3s ease;
	}

	.coverage-badge:hover {
		transform: scale(1.05);
	}

	.w-full { width: 100%; }

	.form-feedback {
		padding: 16px 20px;
		border-radius: 12px;
		font-weight: 600;
		margin-bottom: 25px;
		font-size: 1rem;
	}

	.form-feedback.success {
		background: rgba(34, 197, 94, 0.1);
		border: 1px solid rgba(34, 197, 94, 0.4);
		color: #22c55e;
	}

	.form-feedback.error {
		background: rgba(239, 68, 68, 0.1);
		border: 1px solid rgba(239, 68, 68, 0.4);
		color: #ef4444;
	}

	@media (max-width: 992px) {
		.contact-grid { grid-template-columns: 1fr; }
		.page-hero h1 { font-size: 3rem; }
		.hero-like-title { font-size: 3rem; }
	}

	@media (max-width: 768px) {
		.form-row { grid-template-columns: 1fr; }
		.contact-form-area { padding: 40px 25px; }
		.hero-like-title { font-size: 2.8rem; }
	}

	@media (max-width: 400px) {
		.hero-like-title { font-size: 2rem; }
	}
</style>

