			padding: 70px 20px;
			max-width: 900px;
			margin: 0 auto;
		}

		.section-title {
			font-size: clamp(1.2rem, 3vw, 1.7rem);
			font-weight: 800;
			color: var(--orange);
			text-align: center;
			margin-bottom: 30px;
		}

		.section p {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.8;
			margin-bottom: 18px;
		}

		.section p strong {
			color: var(--white);
		}

		/* ─── SOCIAL PROOF ─────────────────────────────── */
