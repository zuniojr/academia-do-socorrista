---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		:root {
			--dark: #020b18;
			--dark-2: #0a1a2e;
			--orange: #F69D2C;
			--orange-dark: #d98620;
			--white: #FFFFFF;
			--muted: #a0b4c8;
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background-color: var(--dark);
			color: var(--white);
		}

		/* ─── HERO ──────────────────────────────────────── */
		.hero {
			text-align: center;
			padding: 40px 20px 0;
			background: linear-gradient(180deg, #020b18 0%, #0a1530 100%);
		}

		.hero-logo {
			font-size: 0.75rem;
			letter-spacing: 0.3em;
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 20px;
		}

		.hero h1 {
			font-size: clamp(2.2rem, 6vw, 4rem);
			font-weight: 900;
			line-height: 1.1;
			text-transform: uppercase;
			margin-bottom: 20px;
		}

		.hero-subtitle {
			font-size: clamp(1rem, 2.5vw, 1.3rem);
			color: var(--muted);
			max-width: 700px;
			margin: 0 auto 30px;
		}

		/* Video */
		.video-wrapper {
			max-width: 800px;
			margin: 0 auto;
			border-radius: 8px;
			overflow: hidden;
			box-shadow: 0 30px 60px rgba(0,0,0,0.6);
			aspect-ratio: 16/9;
			background: #000;
		}

		.video-wrapper iframe {
			width: 100%;
			height: 100%;
			border: none;
		}

		/* ─── CTA BAND ──────────────────────────────────── */
		.cta-band {
			background: var(--dark-2);
			padding: 50px 20px;
			text-align: center;
		}

		.cta-band p {
			font-size: clamp(1rem, 2vw, 1.2rem);
			font-weight: 600;
			color: var(--white);
			margin-bottom: 25px;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.btn-cta {
			display: inline-block;
			background: var(--orange);
			color: #000;
			font-family: 'Montserrat', sans-serif;
			font-size: 1.1rem;
			font-weight: 800;
			padding: 18px 40px;
			border-radius: 6px;
			text-decoration: none;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			transition: background 0.2s, transform 0.2s;
			box-shadow: 0 6px 20px rgba(246, 157, 44, 0.4);
		}

		.btn-cta:hover {
			background: var(--orange-dark);
			transform: translateY(-2px);
		}

		.btn-cta small {
			display: block;
			font-size: 0.8rem;
			font-weight: 500;
			margin-top: 5px;
			color: rgba(0,0,0,0.7);
		}

		/* ─── WHAT IS ──────────────────────────────────── */
