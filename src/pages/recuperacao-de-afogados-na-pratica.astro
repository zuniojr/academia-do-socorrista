			color: #000;
			letter-spacing: 0.15em;
			text-transform: uppercase;
		}

		/* ─── DESCRIPTION ──────────────────────────────── */
		.desc-section {
			padding: 70px 20px;
			text-align: center;
			max-width: 900px;
			margin: 0 auto;
		}

		.desc-section p {
			font-size: 1rem;
			line-height: 1.8;
			color: var(--muted);
			margin-bottom: 20px;
		}

		.desc-section p strong { color: var(--white); }

		/* ─── MOCKUP ────────────────────────────────────── */
		.mockup-section {
			padding: 40px 20px 70px;
			text-align: center;
			background: var(--dark-2);
		}

		.mockup-section img {
			max-width: 100%;
			width: 700px;
			height: auto;
		}

		/* ─── BENEFITS ─────────────────────────────────── */
		.benefits-section {
			padding: 70px 20px;
			max-width: 800px;
			margin: 0 auto;
		}

		.benefits-title {
			font-size: clamp(1.3rem, 3vw, 1.8rem);
			font-weight: 900;
			text-align: center;
			margin-bottom: 40px;
		}

		.benefit-item {
			display: flex;
			align-items: flex-start;
			gap: 15px;
			margin-bottom: 25px;
		}

		.benefit-check {
			color: var(--orange);
			font-size: 1.3rem;
			flex-shrink: 0;
			margin-top: 2px;
		}

		.benefit-item p {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.6;
		}

		.benefit-item p strong { color: var(--white); }

		/* ─── FAQ ──────────────────────────────────────── */
		.faq-section {
			background: var(--dark-2);
			padding: 70px 20px;
			max-width: 800px;
			margin: 0 auto;
		}

