			background: var(--dark-2);
			padding: 70px 20px;
			text-align: center;
		}

		.proof-title {
			font-size: clamp(1.3rem, 3vw, 1.8rem);
			font-weight: 900;
			max-width: 800px;
			margin: 0 auto 15px;
			line-height: 1.3;
		}

