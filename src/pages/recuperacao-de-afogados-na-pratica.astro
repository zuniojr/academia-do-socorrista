			color: var(--muted);
			font-size: 1rem;
			margin-bottom: 10px;
		}

		.proof-subtitle-2 {
			color: var(--white);
			font-weight: 700;
			font-size: 1rem;
			margin-bottom: 40px;
		}

		.testimonials {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
			gap: 20px;
			max-width: 1000px;
			margin: 0 auto 40px;
			align-items: start;
		}

		.testimonial-card {
			background: rgba(255,255,255,0.04);
			border: 1px solid rgba(255,255,255,0.08);
			border-radius: 12px;
			padding: 25px;
			text-align: left;
		}

		.testimonial-card p {
			font-size: 0.95rem;
			font-style: italic;
			color: var(--muted);
			line-height: 1.7;
			margin-bottom: 20px;
		}

