			height: 300px;
			border-radius: 16px;
			object-fit: cover;
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
		}

		/* ─── EMPATHY ──────────────────────────────────── */
		.empathy-section {
			padding: 60px 20px;
			text-align: center;
			max-width: 1100px;
			margin: 0 auto;
		}

		.empathy-label {
			font-size: 1.6rem;
			letter-spacing: 0.25em;
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 40px;
		}

		.empathy-cards {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 15px;
		}

		.empathy-questions {
			margin-top: 60px;
			text-align: center;
		}

		.empathy-q-title {
			font-size: 1rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			margin-bottom: 40px;
			color: var(--white);
		}

		.empathy-q {
			font-size: 1rem;
			font-weight: 600;
			margin-bottom: 25px;
			color: var(--muted);
			letter-spacing: 0.05em;
		}

		.empathy-card {
			background: var(--dark-2);
			border-radius: 8px;
			overflow: hidden;
		}

		.empathy-card img {
			width: 100%;
			height: 250px;
			object-fit: cover;
			display: block;
		}

		.empathy-card-text {
			padding: 18px 20px;
			text-align: left;
			background: #0d1e35;
			font-size: 0.9rem;
			color: var(--muted);
			line-height: 1.6;
		}

		.empathy-text {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.8;
			margin-bottom: 20px;
		}

		.big-sim {
			font-size: clamp(3rem, 10vw, 6rem);
			font-weight: 900;
			color: var(--white);
			margin: 30px 0;
