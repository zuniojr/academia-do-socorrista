			display: flex;
			align-items: center;
			gap: 12px;
		}

		.testimonial-author img {
			width: 50px;
			height: 50px;
			border-radius: 50%;
			object-fit: cover;
		}

		.author-name {
			font-weight: 700;
			font-size: 0.9rem;
			color: var(--white);
		}

		.author-role {
			font-size: 0.8rem;
			color: var(--orange);
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		/* Featured testimonial card */
		.testimonial-featured {
			text-align: center;
		}

		.testimonial-featured p {
			font-size: 1.05rem;
			line-height: 1.8;
			text-align: left;
		}

		.featured-author {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}

		.featured-photo {
