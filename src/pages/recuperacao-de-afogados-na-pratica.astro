			font-weight: 900;
			text-align: center;
			margin-bottom: 40px;
		}

		.faq-item {
			border-bottom: 1px solid rgba(255,255,255,0.08);
			padding: 20px 0;
		}

		.faq-question {
			font-weight: 700;
			font-size: 1rem;
			color: var(--white);
			margin-bottom: 10px;
		}

		.faq-answer {
			color: var(--muted);
			font-size: 0.95rem;
			line-height: 1.7;
		}

		/* ─── FOOTER ───────────────────────────────────── */
		.page-footer {
			padding: 40px 20px;
			text-align: center;
			background: var(--dark);
			border-top: 1px solid rgba(255,255,255,0.06);
		}

		.page-footer .footer-logo {
			font-size: 0.75rem;
			letter-spacing: 0.3em;
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 20px;
		}

		.footer-links {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 20px;
			margin-bottom: 20px;
		}

		.footer-links a {
			color: var(--muted);
			text-decoration: none;
			font-size: 0.85rem;
			transition: color 0.2s;
		}

		.footer-links a:hover { color: var(--orange); }

		.footer-copy {
			font-size: 0.8rem;
			color: rgba(160,180,200,0.5);
		}

		/* ─── STICKY CTA (mobile) ──────────────────────── */
		.sticky-cta {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			background: var(--orange);
			padding: 15px 20px;
			text-align: center;
			z-index: 999;
			display: none;
		}

		.sticky-cta a {
			color: #000;
			font-weight: 800;
			font-size: 1rem;
			text-decoration: none;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		@media (max-width: 768px) {
			.sticky-cta { display: block; }
			body { padding-bottom: 60px; }
		}
	</style>
</head>
<body>

