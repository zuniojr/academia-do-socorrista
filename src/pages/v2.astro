---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Academia do Socorrista | Treinamento Avançado";
const description = "Domine o Controle de Hemorragias e esteja preparado para salvar vidas em situações de alto risco com as melhores técnicas de resgate.";
---

<Layout title={title} description={description}>
	<Header />
	<main>
		<!-- ============ HERO PRINCIPAL ============ -->
		<section class="hero-main">
			<div class="hero-main__inner animate-fade">
				<div class="container">
					<div class="hero-main__content">
						<h1>Aprenda Atendimento <span class="text-red-hero">Pré-Hospitalar</span> com quem vive o resgate todos os dias.</h1>
						<p>Cursos online desenvolvidos por profissionais experientes para formar socorristas preparados para agir nas situações mais críticas.</p>
						<div class="hero-main__actions">
							<a href="#cursos" class="btn btn-primary-hero">Conheça os Cursos <span class="arrow">&gt;</span></a>
							<a href="#consultoria" class="btn btn-outline-hero">Começar Agora <span class="arrow">&gt;</span></a>
						</div>
					</div>
				</div>
			</div>
			<div class="container">
				<div class="hero-main__badges">
					<div class="hero-main__badge">
						<span class="hero-main__badge-icon">🏅</span>
						<span>Certificado Digital</span>
					</div>
					<div class="hero-main__badge">
						<span class="hero-main__badge-icon">⚡</span>
						<span>Acesso Imediato</span>
					</div>
					<div class="hero-main__badge">
						<span class="hero-main__badge-icon">📚</span>
						<span>Estude no seu ritmo</span>
					</div>
					<div class="hero-main__badge">
						<span class="hero-main__badge-icon">🔄</span>
						<span>Conteúdo Atualizado</span>
					</div>
					<div class="hero-main__badge">
						<span class="hero-main__badge-icon">💳</span>
						<span>Pagamento Facilitado</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ APRENDA DE ONDE ESTIVER ============ -->
		<section class="learn-anywhere">
			<div class="container learn-anywhere__inner">
				<div class="learn-anywhere__content animate-fade">
					<h2>Aprenda de onde estiver.<br/>Quando quiser.</h2>
					<p>Nossa plataforma é moderna, intuitiva e 100% online. Acesse pelo computador, tablet ou celular e tenha uma experiência completa de ensino.</p>
					<ul class="learn-anywhere__list">
						<li><span class="check-icon">✓</span> Vídeos em alta qualidade</li>
						<li><span class="check-icon">✓</span> Materiais de apoio para download</li>
						<li><span class="check-icon">✓</span> Acompanhamento do seu progresso</li>
						<li><span class="check-icon">✓</span> Certificado digital com QR Code</li>
					</ul>
				</div>
				<div class="learn-anywhere__image animate-fade" style="animation-delay: 0.2s;">
					<img src="/images/devices-platform.png" alt="Plataforma de cursos acessível em computador, tablet e celular" />
				</div>
			</div>
		</section>

		<!-- ============ POR QUE ESTUDAR ============ -->
		<section class="why-study">
			<div class="container">
				<div class="why-study__header">
					<h2>Por que estudar <span class="text-gradient">com a gente?</span></h2>
				</div>
				<div class="why-study__grid">
					<div class="why-study__card animate-fade">
						<span class="why-study__icon">👨‍🏫</span>
						<h4>Instrutores atuantes</h4>
						<p>Profissionais que atuam diariamente em ocorrências reais.</p>
					</div>
					<div class="why-study__card animate-fade" style="animation-delay: 0.1s;">
						<span class="why-study__icon">🎯</span>
						<h4>Metodologia prática</h4>
						<p>Casos reais, simulações e protocolos aplicados em campo.</p>
					</div>
					<div class="why-study__card animate-fade" style="animation-delay: 0.2s;">
						<span class="why-study__icon">🔄</span>
						<h4>Conteúdo atualizado</h4>
						<p>Material revisado conforme as últimas diretrizes internacionais.</p>
					</div>
					<div class="why-study__card animate-fade" style="animation-delay: 0.3s;">
						<span class="why-study__icon">🏅</span>
						<h4>Certificado válido</h4>
						<p>Documento oficial reconhecido para currículo e empresas.</p>
					</div>
					<div class="why-study__card animate-fade" style="animation-delay: 0.4s;">
						<span class="why-study__icon">🎧</span>
						<h4>Suporte Dedicado</h4>
						<p>Tire dúvidas com nossa equipe pedagógica durante todo o curso.</p>
					</div>
					<div class="why-study__card animate-fade" style="animation-delay: 0.5s;">
						<span class="why-study__icon">📋</span>
						<h4>Conteúdo objetivo</h4>
						<p>Aulas diretas, sem enrolação, focadas no que realmente importa.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ METODOLOGIA ============ -->
		<section id="sobre" class="about">
			<div class="container about-inner">
				<div class="about-image animate-fade">
					<img src="/images/socorrista-heroico.png" alt="Socorrista Heroico em Pose Confiante - Academia do Socorrista" />
					<a href="https://academia-do-socorrista.vercel.app/domine-o-controle-de-hemorragias" class="experience-badge" style="text-decoration: none; display: flex; align-items: center; justify-content: center;">
						<span class="exp-years" style="font-size: 1.8rem;">Inscreva-se</span>
					</a>
				</div>
				<div class="about-text animate-fade" style="animation-delay: 0.2s;">
					<h2>Metodologia Baseada em <span class="text-gradient">Protocolos Internacionais</span></h2>
					<p>Nosso treinamento é construído sobre bases sólidas, utilizando as diretrizes mais recentes. Preparamos você para agir no momento em que cada segundo conta.</p>
					
					<div class="benefits-list">
						<div class="benefit-item">
							<span class="benefit-icon">⏱️</span>
							<div class="benefit-content">
								<h4>Ação Imediata</h4>
								<p>Técnicas focadas na resposta rápida para preservar a vida em minutos críticos.</p>
							</div>
						</div>
						<div class="benefit-item">
							<span class="benefit-icon">🧠</span>
							<div class="benefit-content">
								<h4>Controle Emocional</h4>
								<p>Treinamento para manter a calma e a precisão sob extrema pressão.</p>
							</div>
						</div>
						<div class="benefit-item">
							<span class="benefit-icon">🛡️</span>
							<div class="benefit-content">
								<h4>Conhecimento Prático</h4>
								<p>Exercícios simulados e cenários reais para garantir a máxima retenção do aprendizado.</p>
							</div>
						</div>
					</div>

					<a href="https://academia-do-socorrista.vercel.app/domine-o-controle-de-hemorragias" class="btn btn-primary">Garantir Inscrição</a>
				</div>
			</div>
		</section>

		<!-- ============ DOMINE O CONTROLE DE HEMORRAGIAS ============ -->
		<section id="cursos" class="domine-hero">
			<div class="container domine-hero__inner">
				<div class="domine-hero__content animate-fade">
					<div class="badge-premium">
						<span class="dot"></span>
						Treinamento Exclusivo
					</div>
					<h2>Domine o <span class="text-gradient">Controle de Hemorragias</span> e salve vidas.</h2>
					<p>Um treinamento completo projetado para profissionais e socorristas que buscam atuar com precisão, segurança e rapidez em situações de emergência.</p>
					<div class="domine-hero__actions">
						<a href="https://academia-do-socorrista.vercel.app/domine-o-controle-de-hemorragias" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Quero me Inscrever</a>
						<a href="https://academia-do-socorrista.vercel.app/domine-o-controle-de-hemorragias" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Conheça o Curso</a>
					</div>
				</div>
				<div class="domine-hero__visual animate-fade" style="animation-delay: 0.3s;">
					<img src="/images/phone-mockup.png" alt="Plataforma Academia do Socorrista no celular" class="domine-hero__phone" />
					<div class="glass-card domine-hero__trust">
						<div class="trust-icon">⚕️</div>
						<div class="trust-info">
							<h4>Acesso Imediato</h4>
							<p>Conteúdo 100% Online</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ POR QUE ESCOLHER ============ -->
		<section class="why-choose">
			<div class="container why-choose__inner">
				<div class="why-choose__content animate-fade">
					<h2>Por que escolher a <span class="text-gradient">Academia do Socorrista?</span></h2>
					<ul class="why-choose__list">
						<li>
							<span class="why-choose__check">✅</span>
							<span>Mais de 40 cursos em Primeiros Socorros e APH</span>
						</li>
						<li>
							<span class="why-choose__check">✅</span>
							<span>Metodologia baseada em casos reais</span>
						</li>
						<li>
							<span class="why-choose__check">✅</span>
							<span>Certificado digital com QR Code</span>
						</li>
						<li>
							<span class="why-choose__check">✅</span>
							<span>Suporte dedicado</span>
						</li>
					</ul>
				</div>
				<div class="why-choose__download animate-fade" style="animation-delay: 0.3s;">
					<div class="why-choose__download-card">
						<span class="why-choose__download-tag">Download gratuito</span>
						<h3>Guia de Primeiros Socorros</h3>
						<p>Baixe gratuitamente nosso guia completo de primeiros socorros e esteja preparado para emergências.</p>
						<img src="/images/ebook-guide.png" alt="E-book Guia de Primeiros Socorros" class="why-choose__ebook" />
						<a href="#" class="btn btn-primary">Baixar Guia Grátis</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ NÚMEROS ============ -->
		<section class="stats-section">
			<div class="container">
				<div class="stats-grid">
					<div class="stat-item animate-fade">
						<span class="stat-number">+40</span>
						<span class="stat-label">Cursos disponíveis</span>
					</div>
					<div class="stat-item animate-fade" style="animation-delay: 0.1s;">
						<span class="stat-number">+500</span>
						<span class="stat-label">Alunos formados</span>
					</div>
					<div class="stat-item animate-fade" style="animation-delay: 0.2s;">
						<span class="stat-number">98%</span>
						<span class="stat-label">Satisfação</span>
					</div>
					<div class="stat-item animate-fade" style="animation-delay: 0.3s;">
						<span class="stat-number">+15</span>
						<span class="stat-label">Instrutores certificados</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ CTA FINAL ============ -->
		<section id="consultoria" class="emergency-cta">
			<div class="container">
				<div class="emergency-box animate-fade">
					<div class="emergency-content">
						<h2>Pronto para salvar vidas em situações críticas?</h2>
						<p>Não espere a emergência acontecer para descobrir que você não está preparado. Torne-se um Socorrista capacitado hoje mesmo.</p>
						<div class="emergency-actions">
							<a href="https://academia-do-socorrista.vercel.app/domine-o-controle-de-hemorragias" class="btn btn-primary btn-large">
								🚑 Fazer Inscrição Agora
							</a>
							<span class="emergency-note">Vagas limitadas para as turmas deste mês!</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />

	<a href="https://bitlybr.net/whatsapp_AS" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
		<svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
	</a>
</Layout>

<style>
	/* ===== HERO PRINCIPAL ===== */
	.hero-main {
		padding: 0 0 20px;
		background: #0a0f1a;
	}

	.hero-main__inner {
		position: relative;
		overflow: hidden;
		background-color: #0a0f1a;
		background-image: url('/images/hero-paramedics.png');
		background-size: cover;
		background-repeat: no-repeat;
		background-position: center;
		min-height: 620px;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.hero-main__inner .container {
		width: 100%;
	}

	.hero-main__inner::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(to right, #0a0f1a 35%, rgba(10, 15, 26, 0.6) 55%, transparent 80%);
		z-index: 1;
	}

	.hero-main__content {
		position: relative;
		z-index: 2;
		max-width: 650px;
		padding: 140px 0 60px 0;
		text-align: left;
	}

	.hero-main__content h1 {
		font-size: clamp(2rem, 3.8vw, 3.5rem);
		line-height: 1.15;
		margin-bottom: 20px;
		font-weight: 800;
		color: #ffffff;
	}

	.text-red-hero {
		color: #E53935;
	}

	.hero-main__content p {
		font-size: 1.1rem;
		color: #C8CDD7;
		margin-bottom: 30px;
		max-width: 500px;
	}

	.hero-main__actions {
		display: flex;
		gap: 15px;
		flex-wrap: wrap;
		justify-content: flex-start;
	}

	.btn-primary-hero {
		background-color: #D62828;
		color: #ffffff;
		padding: 14px 28px;
		border-radius: 6px;
		font-weight: 700;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.btn-primary-hero:hover {
		background-color: #B71C1C;
	}

	.btn-outline-hero {
		background: transparent;
		border: 1px solid #41506B;
		color: white;
		padding: 14px 28px;
		border-radius: 6px;
		font-weight: 700;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}

	.btn-outline-hero:hover {
		background: rgba(255,255,255,0.05);
	}

	.arrow {
		font-weight: bold;
		font-size: 1.1rem;
	}

	.hero-main__badges {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 16px;
		padding-top: 20px;
	}

	.hero-main__badge {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		text-align: center;
		padding: 20px 10px;
		background: rgba(255,255,255,0.03);
		border: 1px solid rgba(255,255,255,0.06);
		border-radius: 16px;
		transition: all 0.3s;
	}

	.hero-main__badge:hover {
		background: rgba(255, 106, 0, 0.08);
		border-color: rgba(255, 106, 0, 0.2);
		transform: translateY(-4px);
	}

	.hero-main__badge-icon {
		font-size: 1.6rem;
	}

	.hero-main__badge span:last-child {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 500;
	}

	/* ===== APRENDA DE ONDE ESTIVER ===== */
	.learn-anywhere {
		padding: 100px 0;
		background: #ffffff;
	}

	.learn-anywhere__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;
	}

	.learn-anywhere__image img {
		width: 100%;
	}

	.learn-anywhere__content h2 {
		font-size: 2.5rem;
		line-height: 1.2;
		margin-bottom: 20px;
		color: #0d1321;
	}

	.learn-anywhere__content p {
		font-size: 1.05rem;
		color: #555555;
		margin-bottom: 30px;
	}

	.learn-anywhere__list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.learn-anywhere__list li {
		font-size: 1.05rem;
		color: #333333;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.check-icon {
		color: var(--primary);
		font-weight: bold;
	}

	/* ===== POR QUE ESTUDAR ===== */
	.why-study {
		padding: 100px 0;
		background: linear-gradient(180deg, #111b2e 0%, #0d1321 100%);
	}

	.why-study__header {
		text-align: center;
		margin-bottom: 60px;
	}

	.why-study__header h2 {
		font-size: 2.5rem;
	}

	.why-study__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.why-study__card {
		background: rgba(255,255,255,0.03);
		border: 1px solid rgba(255,255,255,0.06);
		border-radius: 20px;
		padding: 35px 25px;
		text-align: center;
		transition: all 0.3s;
	}

	.why-study__card:hover {
		background: rgba(255, 106, 0, 0.06);
		border-color: rgba(255, 106, 0, 0.2);
		transform: translateY(-6px);
	}

	.why-study__icon {
		font-size: 2.2rem;
		display: block;
		margin-bottom: 18px;
	}

	.why-study__card h4 {
		font-size: 1.15rem;
		margin-bottom: 10px;
	}

	.why-study__card p {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	/* ===== METODOLOGIA / ABOUT ===== */
	.about {
		padding: 120px 0;
		background: var(--dark);
	}

	.about-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;
	}

	.about-image {
		position: relative;
	}

	.about-image img {
		width: 100%;
		border-radius: 24px;
		box-shadow: 0 30px 60px rgba(0,0,0,0.5);
	}

	.experience-badge {
		position: absolute;
		bottom: -30px;
		right: -30px;
		background: var(--primary);
		padding: 30px;
		border-radius: 24px;
		text-align: center;
		box-shadow: 0 20px 40px var(--primary-glow);
		color: var(--dark);
	}

	.exp-years {
		display: block;
		font-size: 2.5rem;
		font-weight: 800;
		line-height: 1;
	}

	.about-text h2 {
		font-size: 3rem;
		margin-bottom: 25px;
		line-height: 1.2;
	}

	.about-text p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin-bottom: 40px;
	}

	.benefits-list {
		display: flex;
		flex-direction: column;
		gap: 30px;
		margin-bottom: 50px;
	}

	.benefit-item {
		display: flex;
		gap: 20px;
	}

	.benefit-icon {
		font-size: 1.8rem;
		flex-shrink: 0;
	}

	.benefit-content h4 {
		font-size: 1.2rem;
		margin-bottom: 5px;
	}

	.benefit-content p {
		font-size: 0.95rem;
		margin-bottom: 0;
	}

	/* ===== DOMINE O CONTROLE DE HEMORRAGIAS ===== */
	.domine-hero {
		padding: 120px 0;
		background: linear-gradient(135deg, #0a0f1a 0%, #111b2e 50%, #0d1321 100%);
		overflow: hidden;
	}

	.domine-hero__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	.domine-hero__content h2 {
