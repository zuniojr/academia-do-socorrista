---
import Layout from '../layouts/Layout.astro';

const title = "Obrigado | Academia do Socorrista";
const description = "Obrigado por confiar na nossa missão. Siga as instruções para acessar o seu conteúdo.";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
	
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background-color: #000514;
			background-image: radial-gradient(circle at 50% 30%, rgba(20, 40, 80, 0.4) 0%, #000514 80%);
			color: #FFFFFF;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		/* Cabeçalho / Logo Texto */
		header {
			padding: 30px 20px;
			text-align: center;
		}

		.logo-text {
			font-size: 1.2rem;
			font-weight: 700;
			letter-spacing: 0.4em;
			color: #FFFFFF;
			text-transform: uppercase;
		}

		/* Faixa de Aviso */
		.warning-banner {
			background-color: #F69D2C;
			color: #000000;
			text-align: center;
			padding: 15px 20px;
			font-weight: 700;
			font-size: 0.95rem;
			text-transform: uppercase;
		}

		/* Seção Principal / Hero */
		.hero-section {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 60px 20px;
			max-width: 1200px;
			margin: 0 auto;
			gap: 50px;
			flex-wrap: wrap;
		}

		.hero-content {
			flex: 1;
			min-width: 300px;
			max-width: 600px;
		}

		.welcome-text {
			color: #F69D2C;
			font-weight: 700;
			font-size: 1.1rem;
			margin-bottom: 10px;
			text-transform: uppercase;
			letter-spacing: 1px;
		}

		.course-title {
			font-size: 3.5rem;
			font-weight: 800;
			line-height: 1.1;
			margin-bottom: 25px;
			text-transform: uppercase;
		}

		.mission-text {
			font-size: 1.1rem;
			line-height: 1.6;
			color: #E2E8F0;
			margin-bottom: 40px;
		}

		.hero-image-wrapper {
			flex: 1;
			min-width: 300px;
			max-width: 500px;
			display: flex;
			justify-content: center;
		}

		.hero-image {
			width: 100%;
			height: auto;
			filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
		}

		/* Caixa de Confirmação de E-mail */
		.email-confirmation {
			display: flex;
			align-items: flex-start;
			gap: 20px;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.1);
			padding: 25px;
			border-radius: 15px;
		}

		.email-icon-box {
			background: #FFFFFF;
			border: 2px solid #F69D2C;
			border-radius: 12px;
			width: 50px;
			height: 50px;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		.email-icon-box svg {
			width: 24px;
			height: 24px;
			stroke: #F69D2C;
			fill: none;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		.email-text h3 {
			font-size: 1.3rem;
			margin-bottom: 8px;
			color: #FFFFFF;
		}

		.email-text p {
			font-size: 0.95rem;
			color: #B4C4D9;
			line-height: 1.5;
		}

		/* Rodapé / Suporte */
		.support-section {
			text-align: center;
			padding: 60px 20px;
			margin-top: auto;
		}

		.btn-support {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			background-color: #25D366; /* Cor do WhatsApp */
			color: #FFFFFF;
			padding: 16px 32px;
			border-radius: 50px;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.1rem;
			transition: transform 0.2s, box-shadow 0.2s;
			margin-bottom: 40px;
		}

		.btn-support:hover {
			transform: translateY(-3px);
			box-shadow: 0 10px 20px rgba(37, 211, 102, 0.3);
		}

		.btn-support svg {
			width: 24px;
			height: 24px;
			fill: currentColor;
		}

		.legal-links {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 20px;
			margin-top: 20px;
		}

		.legal-links a {
			color: #64748B;
			text-decoration: none;
			font-size: 0.85rem;
			transition: color 0.2s;
		}

		.legal-links a:hover {
			color: #F69D2C;
		}

		@media (max-width: 768px) {
			.course-title {
				font-size: 2.5rem;
			}
			.hero-section {
				text-align: center;
				padding: 40px 20px;
			}
			.email-confirmation {
				text-align: left;
			}
		}
	</style>
</head>
<body>
	<header>
		<div class="logo-text">A C A D E M I A &nbsp; D O &nbsp; S O C O R R I S T A</div>
	</header>

	<div class="warning-banner">
		IMPORTANTE: Siga as instruções abaixo para acessar ao seu conteúdo:
	</div>

	<main class="hero-section">
		<div class="hero-content">
			<div class="welcome-text">PARABÉNS, seja muito bem-vindo(a) ao</div>
			<h1 class="course-title">RECUPERAÇÃO DE AFOGADOS NA PRÁTICA</h1>
			<p class="mission-text">Obrigado por confiar nessa missão. Juntos, vamos transformar resgates em histórias de vida.</p>
			
			<div class="email-confirmation">
				<div class="email-icon-box">
					<svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
				</div>
				<div class="email-text">
					<h3>Verifique seu e-mail</h3>
					<p>Em breve, você receberá um e-mail nosso, com todas as instruções de como acessar ao curso.</p>
				</div>
			</div>
		</div>

		<div class="hero-image-wrapper">
			<img src="https://academiadosocorrista.com.br/wp-content/uploads/2025/04/note-ideal-1.png" alt="Acesso ao curso no notebook" class="hero-image" />
		</div>
	</main>

	<footer class="support-section">
		<a href="https://wa.me/5547996372129?text=Comprei%20o%20curso%20Recupera%C3%A7%C3%A3o%20de%20Afogados%20na%20Pr%C3%A1tica%20e%20n%C3%A3o%20recebi%20o%20e-mail%20de%20confirma%C3%A7%C3%A3o.Voc%C3%AA%20poderia%20me%20ajudar%20com%20isto?" class="btn-support" target="_blank" rel="noopener noreferrer">
			<svg viewBox="0 0 24 24"><path d="M12.031 2C6.52 2 2.033 6.486 2.033 11.998c0 1.761.458 3.413 1.258 4.851l-1.337 4.887 4.996-1.312c1.406.768 3.004 1.21 4.708 1.21 5.51 0 9.995-4.486 9.995-9.998 0-5.512-4.485-9.998-9.995-9.998zm0 1.5c4.685 0 8.496 3.81 8.496 8.498 0 4.686-3.811 8.498-8.496 8.498-1.503 0-2.914-.393-4.14-1.077l-.297-.165-2.973.781.799-2.923-.182-.289c-.732-1.168-1.163-2.553-1.163-4.032.001-4.688 3.812-8.498 8.496-8.498zm-3.649 3.256c-.198 0-.462.073-.704.331-.243.258-.928.906-.928 2.208s.948 2.562 1.08 2.741c.132.178 1.867 2.85 4.522 3.996.632.272 1.125.435 1.509.557.635.202 1.213.174 1.669.107.509-.074 1.564-.638 1.786-1.257.221-.617.221-1.147.155-1.257-.066-.111-.242-.178-.508-.312s-1.564-.771-1.808-.859c-.243-.088-.419-.133-.596.133s-.685.859-.839 1.036c-.155.178-.309.2-.575.067-.265-.133-1.121-.413-2.135-1.319-.789-.702-1.321-1.569-1.476-1.834-.155-.265-.016-.409.117-.541.12-.119.265-.311.398-.466.133-.155.177-.266.265-.443.088-.178.044-.333-.022-.466-.066-.133-.596-1.33-.817-1.868-.216-.527-.456-.456-.63-.464z"/></svg>
			Preciso de ajuda
		</a>
		
		<div class="legal-links">
			<a href="/termos-de-uso">Termos de Uso</a>
			<a href="/politica-de-privacidade">Política de Privacidade</a>
			<a href="/consideracoes-importantes">Considerações Importantes</a>
			<a href="/contato">Contato</a>
		</div>
	</footer>
</body>
</html>
