---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VisualEditor from '../components/admin/VisualEditor.astro';
import sobreData from '../data/pages/sobre.json';

const title = sobreData.meta.title;
const description = sobreData.meta.description;
---

<Layout title={title} description={description}>
	<VisualEditor pageName="Sobre Nós" />
	<Header />
	<main>
		<section class="page-hero">
			<div class="container animate-fade">
				<span class="section-badge" data-editable-id="hero.badge" data-editable-label="Distintivo Hero" data-editable-type="text">
					{sobreData.hero.badge}
				</span>
				<h1>
					<span data-editable-id="hero.titlePrefix" data-editable-label="Título (Início)" data-editable-type="text">{sobreData.hero.titlePrefix}</span><span class="text-gradient" data-editable-id="hero.titleHighlight" data-editable-label="Título (Destaque)" data-editable-type="text">{sobreData.hero.titleHighlight}</span>{sobreData.hero.titleSuffix}
				</h1>
				<div class="hero-text">
					<p data-editable-id="hero.paragraph1" data-editable-label="Parágrafo 1" data-editable-type="textarea">{sobreData.hero.paragraph1}</p>
					<p data-editable-id="hero.paragraph2" data-editable-label="Parágrafo 2" data-editable-type="textarea">{sobreData.hero.paragraph2}</p>
					<p data-editable-id="hero.paragraph3" data-editable-label="Parágrafo 3" data-editable-type="textarea">{sobreData.hero.paragraph3}</p>
					<p data-editable-id="hero.paragraph4" data-editable-label="Parágrafo 4" data-editable-type="textarea">{sobreData.hero.paragraph4}</p>
					<p data-editable-id="hero.paragraph5" data-editable-label="Parágrafo 5" data-editable-type="textarea">{sobreData.hero.paragraph5}</p>
					<p class="destaque" data-editable-id="hero.destaque" data-editable-label="Parágrafo Destaque" data-editable-type="textarea">{sobreData.hero.destaque}</p>
				</div>
			</div>
		</section>

		<section class="about-timeline">
			<div class="container">
				<div class="timeline-box glass-card animate-fade">
					<div class="timeline-content">
						<h2 class="text-gradient" data-editable-id="mission.title" data-editable-label="Título da Missão" data-editable-type="text">{sobreData.mission.title}</h2>
						<p data-editable-id="mission.paragraph1" data-editable-label="Missão - Parágrafo 1" data-editable-type="textarea">{sobreData.mission.paragraph1}</p>
						<p data-editable-id="mission.paragraph2" data-editable-label="Missão - Parágrafo 2" data-editable-type="textarea">{sobreData.mission.paragraph2}</p>
						<p data-editable-id="mission.paragraph3" data-editable-label="Missão - Parágrafo 3" data-editable-type="textarea">{sobreData.mission.paragraph3}</p>
						
						<div class="values-badges">
							<div class="value-item" data-editable-id="mission.value1" data-editable-label="Valor 1" data-editable-type="text">{sobreData.mission.value1}</div>
							<div class="value-item" data-editable-id="mission.value2" data-editable-label="Valor 2" data-editable-type="text">{sobreData.mission.value2}</div>
							<div class="value-item" data-editable-id="mission.value3" data-editable-label="Valor 3" data-editable-type="text">{sobreData.mission.value3}</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.page-hero {
		padding: 200px 0 100px;
		background: var(--dark-surface);
		text-align: center;
		border-bottom: 1px solid var(--glass-border);
	}

	.page-hero h1 {
		font-size: 3.5rem;
		margin-bottom: 40px;
		color: white;
	}

	.hero-text {
		max-width: 720px;
		margin: 0 auto;
	}

	.hero-text p {
		font-size: 1.2rem;
		color: var(--text-muted);
		line-height: 1.8;
		margin-bottom: 18px;
	}

	.hero-text p.destaque {
		color: white;
		font-weight: 600;
		font-size: 1.25rem;
		border-left: 3px solid var(--primary);
		padding-left: 20px;
		margin-top: 30px;
	}

	.about-timeline {
		padding: 60px 0 150px;
	}

	.timeline-box {
		padding: 80px 60px;
		max-width: 900px;
		margin: 0 auto;
	}

	.timeline-content h2 {
		font-size: 2.5rem;
		margin-bottom: 30px;
		text-align: center;
	}

	.timeline-content p {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.8;
		margin-bottom: 25px;
	}

	.values-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 15px;
		margin-top: 40px;
		justify-content: center;
	}

	.value-item {
		background: rgba(255, 215, 0, 0.1);
		color: var(--primary);
		border: 1px solid var(--primary);
		padding: 10px 20px;
		border-radius: 100px;
		font-weight: 700;
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.page-hero h1 { font-size: 3rem; }
		.timeline-box { padding: 60px 30px; }
	}
</style>

