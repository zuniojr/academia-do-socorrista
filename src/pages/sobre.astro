---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Sobre Nós | Academia do Socorrista";
const description = "A Academia do Socorrista foi criada para mudar a forma como as pessoas aprendem a salvar vidas. Treinamento prático, situações reais, comunidade forte.";

const team = [
  {
    name: 'Instrutor Silva',
    role: 'Especialista em Trauma',
    bio: 'Mais de 15 anos de experiência atuando na linha de frente do resgate e instruindo novos socorristas.',
    image: 'https://images.unsplash.com/photo-1579684385127-1ef15d508118?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Dr. Roberto Santos',
    role: 'Diretor Médico',
    bio: 'Médico emergencista e cirurgião do trauma, responsável pela validação científica dos protocolos do treinamento.',
    image: 'https://images.unsplash.com/photo-1622253692010-333f2da6031d?q=80&w=400&auto=format&fit=crop'
  },
  {
    name: 'Cap. Oliveira',
    role: 'Instrutor Master TCCC',
    bio: 'Militar e especialista em APH Tático, desenvolvendo as práticas de sobrevivência sob situações extremas.',
    image: 'https://images.unsplash.com/photo-1541881452934-8cddfc58bcdf?q=80&w=400&auto=format&fit=crop'
  }
];
---

<Layout title={title} description={description}>
	<Header />
	<main>
		<section class="page-hero">
			<div class="container animate-fade">
				<span class="section-badge">Treinamento Especializado</span>
				<h1>O que é a Academia do <span class="text-gradient">Socorrista</span>?</h1>
				<div class="hero-text">
					<p>A maioria das pessoas acha que sabe agir em uma emergência…</p>
					<p>até o momento em que alguém precisa de ajuda de verdade.</p>
					<p>É aí que o nervosismo trava.<br/>A dúvida aparece.<br/>E segundos fazem diferença.</p>
					<p>A Academia do Socorrista foi criada para mudar isso.</p>
					<p>Aqui, você aprende na prática, treina situações reais e faz parte de uma comunidade que evolui junto todos os dias.</p>
					<p class="destaque">Não é só teoria.<br/>Não é só certificado.<br/>É preparo real para quem quer ter confiança, agir rápido e fazer a diferença quando mais importa.</p>
				</div>
			</div>
		</section>

		<section class="about-timeline">
			<div class="container">
				<div class="timeline-box glass-card animate-fade">
					<div class="timeline-content">
						<h2>Nossa Missão</h2>
						<p>Fundada para trazer conhecimento de ponta para profissionais da área da saúde e segurança, a **Academia do Socorrista** nasceu com o objetivo claro de salvar o maior número de vidas possível através da educação.</p>
						<p>Investimos constantemente na atualização dos nossos protocolos e simulações para garantir que nossos alunos hajam com precisão extrema nos momentos críticos.</p>
						
						<div class="values-badges">
							<div class="value-item">⭐ Salvando Vidas</div>
							<div class="value-item">⭐ Protocolos Atuais</div>
							<div class="value-item">⭐ Controle e Resiliência</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.page-hero {
		padding: 200px 0 100px;
		background: var(--dark-surface);
		text-align: center;
		border-bottom: 1px solid var(--glass-border);
	}

	.page-hero h1 {
		font-size: 3.5rem;
		margin-bottom: 40px;
		color: white;
	}

	.hero-text {
		max-width: 720px;
		margin: 0 auto;
	}

	.hero-text p {
		font-size: 1.2rem;
		color: var(--text-muted);
		line-height: 1.8;
		margin-bottom: 18px;
	}

	.hero-text p.destaque {
		color: white;
		font-weight: 600;
		font-size: 1.25rem;
		border-left: 3px solid var(--primary);
		padding-left: 20px;
		margin-top: 30px;
	}

	.about-timeline {
		padding: 60px 0 150px;
	}

	.timeline-box {
		padding: 80px 60px;
		max-width: 900px;
		margin: 0 auto;
	}

	.timeline-content h2 {
		font-size: 2.5rem;
		margin-bottom: 30px;
		text-align: center;
	}

	.timeline-content p {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.8;
		margin-bottom: 25px;
	}

	.values-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 15px;
		margin-top: 40px;
		justify-content: center;
	}

	.value-item {
		background: rgba(255, 215, 0, 0.1);
		color: var(--primary);
		border: 1px solid var(--primary);
		padding: 10px 20px;
		border-radius: 100px;
		font-weight: 700;
		font-size: 0.9rem;
	}

	@media (max-width: 768px) {
		.page-hero h1 { font-size: 3rem; }
		.timeline-box { padding: 60px 30px; }
	}
</style>
