---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Academia do Socorrista | Execute com Segurança";
const description = "Chegou a hora de executar. Você encontrou o caminho verdadeiro para salvar vidas com segurança.";
---

<Layout title={title} description={description}>
	<Header />
	
	<main class="teste-home-main">
		<div class="hero-bg">
			<img src="/images/dashboard-aph-bg.png" alt="Background de Tecnologia em APH" class="bg-blur-image" />
			<div class="gradient-overlay"></div>
		</div>

		<section class="hero-content">
			<div class="container text-center relative-z">
				<h1 class="main-headline">
					<span class="highlight-magenta">Chegou a hora de executar.</span><br>
					Você encontrou o caminho verdadeiro para salvar vidas com segurança.
				</h1>
				
				<p class="subheadline">
					Academia do Socorrista, você aprende, aplica e cresce com a plataforma que une educação, tecnologia e comunidade, em um único lugar, focado no seu crescimento.
				</p>

				<a href="#" class="btn-cta-magenta">
					ENTRAR AGORA
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* CORES DA PÁGINA */
	:root {
		--teste-dark-bg: #050505;
		--teste-magenta: #FF0055;
		--teste-pink: #FF1493;
		--teste-text-light: #a0aec0;
	}

	.teste-home-main {
		position: relative;
		min-height: 100vh;
		background: radial-gradient(circle at center, #101524 0%, var(--teste-dark-bg) 70%, #000000 100%);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 80px; /* offset para o header */
		padding-bottom: 80px;
	}

	/* BACKGROUND COM IMAGEM DESFOCADA E GRADIENTE */
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
	}

	.bg-blur-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.15;
		filter: blur(8px);
		mix-blend-mode: screen;
	}

	.gradient-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at center, transparent 0%, var(--teste-dark-bg) 85%);
	}

	/* CONTEÚDO HERO */
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 900px;
		margin: 0 auto;
		padding: 0 20px;
	}

	.main-headline {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 900;
		line-height: 1.1;
		color: #ffffff;
		margin-bottom: 30px;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		font-family: 'Outfit', 'Montserrat', sans-serif;
	}

	.highlight-magenta {
		color: var(--teste-magenta);
		display: block;
		margin-bottom: 15px;
		text-shadow: 0 0 30px rgba(255, 0, 85, 0.4);
	}

	.subheadline {
		font-size: clamp(1rem, 2.5vw, 1.25rem);
		line-height: 1.6;
		color: var(--teste-text-light);
		max-width: 700px;
		margin: 0 auto 50px auto;
		font-weight: 400;
	}

	/* BOTÃO CTA */
	.btn-cta-magenta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		background: linear-gradient(135deg, var(--teste-magenta) 0%, var(--teste-pink) 100%);
		color: #ffffff;
		font-size: 1.25rem;
		font-weight: 800;
		padding: 22px 50px;
		border-radius: 50px;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		box-shadow: 0 10px 40px rgba(255, 0, 85, 0.5);
		transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.btn-cta-magenta:hover {
		transform: translateY(-5px) scale(1.02);
		box-shadow: 0 15px 50px rgba(255, 0, 85, 0.7);
		background: linear-gradient(135deg, var(--teste-pink) 0%, var(--teste-magenta) 100%);
	}

	.btn-icon {
		transition: transform 0.3s ease;
	}

	.btn-cta-magenta:hover .btn-icon {
		transform: translateX(5px);
	}

	.text-center { text-align: center; }
	.relative-z { position: relative; z-index: 10; }

	/* MOBILE */
	@media (max-width: 768px) {
		.teste-home-main {
			padding-top: 100px;
		}
		
		.main-headline {
			font-size: 2.2rem;
			margin-bottom: 25px;
		}
		
		.subheadline {
			font-size: 1.05rem;
			margin-bottom: 40px;
		}

		.btn-cta-magenta {
			padding: 18px 30px;
			font-size: 1.1rem;
			width: 100%;
			max-width: 350px;
		}
	}
</style>
