---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Academia do Socorrista | Execute com Segurança";
const description = "Chegou a hora de executar. Você encontrou o caminho verdadeiro para salvar vidas com segurança.";
---

<Layout title={title} description={description}>
	<Header />
	
	<main class="teste-home-main">
		<div class="hero-bg">
			<img src="/images/dashboard-aph-bg.png" alt="Background de Tecnologia em APH" class="bg-blur-image" />
			<div class="gradient-overlay"></div>
		</div>

		<section class="hero-content">
			<div class="container text-center relative-z">
				<div class="brand-badge" style="margin-top: 40px; margin-bottom: 60px;">
					<img src="/images/logo-academia.svg" alt="Academia do Socorrista" style="max-height: 70px; width: auto;" />
				</div>
				<h1 class="main-headline">
					<span class="highlight-magenta">Chegou a hora de executar.</span> Você encontrou o caminho verdadeiro para salvar vidas com segurança.
				</h1>
				
				<p class="subheadline">
					Academia do Socorrista, você aprende, aplica e cresce com a plataforma que une <span class="highlight-blue">educação, tecnologia e comunidade</span>, em um único lugar, focado no seu crescimento.
				</p>

				<a href="#" class="btn-cta-magenta">
					ENTRAR AGORA
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
						<line x1="7" y1="17" x2="17" y2="7"></line>
						<polyline points="7 7 17 7 17 17"></polyline>
					</svg>
				</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	/* CORES DA PÁGINA */
	:root {
		--teste-dark-bg: #0b0213; /* Fundo mais puxado pro roxo escuro do modelo */
		--teste-magenta: #FF0044;
		--teste-pink: #FF0044;
		--teste-blue: #3b82f6; /* Azul do texto */
		--teste-text-light: #ffffff;
	}

	.teste-home-main {
		position: relative;
		min-height: 100vh;
		background: radial-gradient(circle at center, #101524 0%, var(--teste-dark-bg) 70%, #000000 100%);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-top: 80px; /* offset para o header */
		padding-bottom: 80px;
	}

	/* BACKGROUND COM IMAGEM DESFOCADA E GRADIENTE */
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
	}

	.bg-blur-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.15;
		filter: blur(8px);
		mix-blend-mode: screen;
	}

	.gradient-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: radial-gradient(circle at center, transparent 0%, var(--teste-dark-bg) 85%);
	}

	/* CONTEÚDO HERO */
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 900px;
		margin: 0 auto;
		padding: 0 20px;
	}

	.main-headline {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
		line-height: 1.2;
		color: #ffffff;
		margin-bottom: 20px;
		letter-spacing: -0.02em;
		font-family: 'Outfit', 'Montserrat', sans-serif;
	}

	.highlight-magenta {
		color: var(--teste-magenta);
		display: inline;
		text-shadow: none; /* Removido o glow do texto para ficar mais fiel ao modelo */
	}

	.subheadline {
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		line-height: 1.5;
		color: var(--teste-text-light);
		max-width: 800px;
		margin: 0 auto 40px auto;
		font-weight: 600; /* Mais grosso como no modelo */
	}

	.highlight-blue {
		color: var(--teste-blue);
	}

	/* BOTÃO CTA */
	.btn-cta-magenta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--teste-magenta); /* Fundo sólido como no modelo */
		color: #ffffff;
		font-size: 1rem;
		font-weight: 700;
		padding: 16px 36px;
		border-radius: 50px;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		transition: all 0.2s ease;
		box-shadow: 0 4px 15px rgba(255, 0, 68, 0.3); /* Sombra mais sutil */
	}

	.btn-cta-magenta:hover {
		transform: scale(1.02);
		background: #e6003d; /* Leve escurecida no hover */
	}

	.btn-icon {
		transition: transform 0.2s ease;
	}

	.btn-cta-magenta:hover .btn-icon {
		transform: translate(2px, -2px); /* Animação para diagonal superior direita */
	}

	.text-center { text-align: center; }
	.relative-z { position: relative; z-index: 10; }

	/* BRAND LOGO */
	.brand-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 16px;
		margin-bottom: 40px;
		font-family: 'Outfit', 'Montserrat', sans-serif;
	}

	.brand-icon {
		width: 56px;
		height: 56px;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.1;
	}

	.brand-text-top {
		font-size: 1.35rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: 0.02em;
	}

	.brand-text-bottom {
		font-size: 1.65rem;
		font-weight: 800;
		color: #f0a070;
		letter-spacing: 0.02em;
		font-style: italic;
	}

	/* MOBILE */
	@media (max-width: 768px) {
		.teste-home-main {
			padding-top: 100px;
		}
		
		.main-headline {
			font-size: 2.2rem;
			margin-bottom: 25px;
		}
		
		.subheadline {
			font-size: 1.05rem;
			margin-bottom: 40px;
		}

		.btn-cta-magenta {
			padding: 18px 30px;
			font-size: 1.1rem;
			width: 100%;
			max-width: 350px;
		}
	}
</style>
