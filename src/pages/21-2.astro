---
const title = "Recuperação de Afogados na Prática | Academia do Socorrista";
const description = "A vítima está fora da água. Mas será que ela está realmente salva? Aprenda os protocolos corretos de recuperação de afogados.";
const checkoutUrl = "https://pay.kiwify.com.br/DSavxbo";
const whatsappUrl = "https://api.whatsapp.com/send?phone=5547996372129&text=Tenho%20uma%20d%C3%BAvida%20sobre%20o%20curso%20de%20Recupera%C3%A7%C3%A3o%20de%20Afogados";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{title}</title>
	<meta name="description" content={description}>
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet">
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		:root {
			--dark: #020b18;
			--dark-2: #0a1a2e;
			--orange: #F69D2C;
			--orange-dark: #d98620;
			--white: #FFFFFF;
			--muted: #a0b4c8;
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background-color: var(--dark);
			color: var(--white);
		}

		/* ─── HERO ──────────────────────────────────────── */
		.hero {
			text-align: center;
			padding: 40px 20px 0;
			background: linear-gradient(180deg, #020b18 0%, #0a1530 100%);
		}

		.hero-logo {
			font-size: clamp(0.38rem, 2.8vw, 0.7rem);
			letter-spacing: clamp(0.04em, 0.4vw, 0.1em);
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 20px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			max-width: 100%;
		}

		.hero h1 {
			font-size: clamp(2.2rem, 6vw, 4rem);
			font-weight: 900;
			line-height: 1.1;
			text-transform: uppercase;
			margin-bottom: 20px;
		}

		.hero-subtitle {
			font-size: clamp(1rem, 2.5vw, 1.3rem);
			color: var(--muted);
			max-width: 700px;
			margin: 0 auto 30px;
		}

		/* Video */
		.video-wrapper {
			max-width: 800px;
			margin: 0 auto;
			border-radius: 8px;
			overflow: hidden;
			box-shadow: 0 30px 60px rgba(0,0,0,0.6);
			aspect-ratio: 16/9;
			background: #000;
		}

		.video-wrapper iframe {
			width: 100%;
			height: 100%;
			border: none;
		}

		/* ─── CTA BAND ──────────────────────────────────── */
		.cta-band {
			background: var(--dark-2);
			padding: 50px 20px;
			text-align: center;
		}

		.cta-band p {
			font-size: clamp(1rem, 2vw, 1.2rem);
			font-weight: 600;
			color: var(--white);
			margin-bottom: 25px;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.btn-cta {
			display: inline-block;
			background: var(--orange);
			color: #000;
			font-family: 'Montserrat', sans-serif;
			font-size: 1.1rem;
			font-weight: 800;
			padding: 18px 40px;
			border-radius: 6px;
			text-decoration: none;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			transition: background 0.2s, transform 0.2s;
			box-shadow: 0 6px 20px rgba(246, 157, 44, 0.4);
		}

		.btn-cta:hover {
			background: var(--orange-dark);
			transform: translateY(-2px);
		}

		.btn-cta small {
			display: block;
			font-size: 0.8rem;
			font-weight: 500;
			margin-top: 5px;
			color: rgba(0,0,0,0.7);
		}

		/* ─── WHAT IS ──────────────────────────────────── */
		.section {
			padding: 70px 20px;
			max-width: 900px;
			margin: 0 auto;
		}

		.section-title {
			font-size: clamp(1.2rem, 3vw, 1.7rem);
			font-weight: 800;
			color: var(--orange);
			text-align: center;
			margin-bottom: 30px;
		}

		.section p {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.8;
			margin-bottom: 18px;
		}

		.section p strong {
			color: var(--white);
		}

		/* ─── SOCIAL PROOF ─────────────────────────────── */
		.proof-section {
			background: var(--dark-2);
			padding: 70px 20px;
			text-align: center;
		}

		.proof-title {
			font-size: clamp(1.3rem, 3vw, 1.8rem);
			font-weight: 900;
			max-width: 800px;
			margin: 0 auto 15px;
			line-height: 1.3;
		}

		.proof-subtitle {
			color: var(--muted);
			font-size: 1rem;
			margin-bottom: 10px;
		}

		.proof-subtitle-2 {
			color: var(--white);
			font-weight: 700;
			font-size: 1rem;
			margin-bottom: 40px;
		}

		.testimonials {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
			gap: 20px;
			max-width: 1000px;
			margin: 0 auto 40px;
		}

		.testimonial-card {
			background: rgba(255,255,255,0.04);
			border: 1px solid rgba(255,255,255,0.08);
			border-radius: 12px;
			padding: 25px;
			text-align: left;
		}

		.testimonial-card p {
			font-size: 0.95rem;
			font-style: italic;
			color: var(--muted);
			line-height: 1.7;
			margin-bottom: 20px;
		}

		.testimonial-author {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.testimonial-author img {
			width: 50px;
			height: 50px;
			border-radius: 50%;
			object-fit: cover;
		}

		.author-name {
			font-weight: 700;
			font-size: 0.9rem;
			color: var(--white);
		}

		.author-role {
			font-size: 0.8rem;
			color: var(--orange);
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		/* ─── EMPATHY ──────────────────────────────────── */
		.empathy-section {
			padding: 60px 20px;
			text-align: center;
			max-width: 1100px;
			margin: 0 auto;
		}

		.empathy-label {
			font-size: 0.8rem;
			letter-spacing: 0.25em;
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 40px;
		}

		.empathy-cards {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 15px;
		}

		.empathy-card {
			background: var(--dark-2);
			border-radius: 8px;
			overflow: hidden;
		}

		.empathy-card img {
			width: 100%;
			height: 250px;
			object-fit: cover;
			display: block;
		}

		.empathy-card-text {
			padding: 18px 20px;
			text-align: left;
			background: #0d1e35;
			font-size: 0.9rem;
			color: var(--muted);
			line-height: 1.6;
		}

		.empathy-text {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.8;
			margin-bottom: 20px;
		}

		.big-sim {
			font-size: clamp(3rem, 10vw, 6rem);
			font-weight: 900;
			color: var(--white);
			margin: 30px 0;
		}

		@media (max-width: 992px) {
			.empathy-cards {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (max-width: 768px) {
			.empathy-cards {
				grid-template-columns: 1fr;
			}
		}

		/* ─── GOOD NEWS ────────────────────────────────── */
		.good-news {
			background: var(--orange);
			padding: 20px;
			text-align: center;
		}

		.good-news p {
			font-weight: 800;
			font-size: clamp(0.9rem, 2vw, 1.1rem);
			color: #000;
			letter-spacing: 0.15em;
			text-transform: uppercase;
		}

		/* ─── DESCRIPTION ──────────────────────────────── */
		.desc-section {
			padding: 70px 20px;
			text-align: center;
			max-width: 900px;
			margin: 0 auto;
		}

		.desc-section p {
			font-size: 1rem;
			line-height: 1.8;
			color: var(--muted);
			margin-bottom: 20px;
		}

		.desc-section p strong { color: var(--white); }

		/* ─── MOCKUP ────────────────────────────────────── */
		.mockup-section {
			padding: 40px 20px 70px;
			text-align: center;
			background: var(--dark-2);
		}

		.mockup-section img {
			max-width: 100%;
			width: 700px;
			height: auto;
		}

		/* ─── BENEFITS ─────────────────────────────────── */
		.benefits-section {
			padding: 70px 20px;
			max-width: 800px;
			margin: 0 auto;
		}

		.benefits-title {
			font-size: clamp(1.3rem, 3vw, 1.8rem);
			font-weight: 900;
			text-align: center;
			margin-bottom: 40px;
		}

		.benefit-item {
			display: flex;
			align-items: flex-start;
			gap: 15px;
			margin-bottom: 25px;
		}

		.benefit-check {
			color: var(--orange);
			font-size: 1.3rem;
			flex-shrink: 0;
			margin-top: 2px;
		}

		.benefit-item p {
			color: var(--muted);
			font-size: 1rem;
			line-height: 1.6;
		}

		.benefit-item p strong { color: var(--white); }

		/* ─── FAQ ──────────────────────────────────────── */
		.faq-section {
			background: var(--dark-2);
			padding: 70px 20px;
			max-width: 800px;
			margin: 0 auto;
		}

		.faq-title {
			font-size: clamp(1.3rem, 3vw, 1.8rem);
			font-weight: 900;
			text-align: center;
			margin-bottom: 40px;
		}

		.faq-item {
			border-bottom: 1px solid rgba(255,255,255,0.08);
			padding: 20px 0;
		}

		.faq-question {
			font-weight: 700;
			font-size: 1rem;
			color: var(--white);
			margin-bottom: 10px;
		}

		.faq-answer {
			color: var(--muted);
			font-size: 0.95rem;
			line-height: 1.7;
		}

		/* ─── FOOTER ───────────────────────────────────── */
		.page-footer {
			padding: 40px 20px;
			text-align: center;
			background: var(--dark);
			border-top: 1px solid rgba(255,255,255,0.06);
		}

		.page-footer .footer-logo {
			font-size: 0.75rem;
			letter-spacing: 0.3em;
			color: var(--muted);
			text-transform: uppercase;
			margin-bottom: 20px;
		}

		.footer-links {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 20px;
			margin-bottom: 20px;
		}

		.footer-links a {
			color: var(--muted);
			text-decoration: none;
			font-size: 0.85rem;
			transition: color 0.2s;
		}

		.footer-links a:hover { color: var(--orange); }

		.footer-copy {
			font-size: 0.8rem;
			color: rgba(160,180,200,0.5);
		}

		/* ─── STICKY CTA (mobile) ──────────────────────── */
		.sticky-cta {
			position: fixed;
			bottom: 0;
			left: 0;
			right: 0;
			background: var(--orange);
			padding: 15px 20px;
			text-align: center;
			z-index: 999;
			display: none;
		}

		.sticky-cta a {
			color: #000;
			font-weight: 800;
			font-size: 1rem;
			text-decoration: none;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		@media (max-width: 768px) {
			.sticky-cta { display: block; }
			body { padding-bottom: 60px; }
		}
	</style>
</head>
<body>

<!-- ─── HERO ─────────────────────────────────────────── -->
<section class="hero">
	<div class="hero-logo">ACADEMIA DO SOCORRISTA</div>
	<h1>RECUPERAÇÃO<br>DE AFOGADOS<br>NA PRÁTICA</h1>
	<p class="hero-subtitle">A vítima está fora da água. Mas será que ela está realmente salva?</p>
